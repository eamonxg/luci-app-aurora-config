#!/bin/sh

. /usr/share/libubox/jshn.sh

readonly ICON_PATH="/www/luci-static/aurora/images"
readonly FONT_PATH="/www/luci-static/aurora/fonts"
readonly FONT_CSS_FILE="$FONT_PATH/aurora-font.css"
readonly FONT_JOB_PATH="/tmp/aurora_font_jobs"
readonly FONT_TMP_UPLOAD="/tmp/aurora_font.tmp"
readonly FONT_CUSTOM_PATH="$FONT_PATH/custom"
readonly MAX_UPLOAD=8388608
readonly TMP_UPLOAD_PATH="/tmp/aurora_icon.tmp"
readonly CONFIG_FILE="/etc/config/aurora"
readonly DEFAULT_TEMPLATE="/usr/share/aurora/default.template"
readonly SAGE_GREEN_TEMPLATE="/usr/share/aurora/sage-green.template"
readonly AMBER_SAND_TEMPLATE="/usr/share/aurora/amber-sand.template"
readonly MONOCHROME_TEMPLATE="/usr/share/aurora/monochrome.template"
readonly SKY_BLUE_TEMPLATE="/usr/share/aurora/sky-blue.template"
readonly FONT_PRESETS_FILE="/usr/share/aurora/font-presets.conf"
readonly IMPORT_CONFIG_TMP="/tmp/aurora_config_import.tmp"
readonly EXPORT_CONFIG_TMP="/tmp/aurora_config_export.conf"
readonly COLOR_TOKENS_FILE="/usr/share/aurora/color-tokens.conf"
readonly HUB_BASE="https://themes.eamonxg.fun"
readonly AURORA_FEED_HOST="openwrt.eamonxg.fun"
# opkg names a trusted key file after its keynum: the hex of bytes 3-10 of the
# base64-decoded key line. Computed once with openwrt-cloud's usign-fpr.sh so
# devices need no usign binary. Rotating the key means changing this too.
readonly AURORA_FEED_FPR="82d72f5ededb6163"
readonly AURORA_FEED_CHANNEL="snapshots"
readonly AURORA_FEED_KEYS="/usr/share/aurora/feed"
readonly DEVICE_DIR="/etc/aurora"
readonly HUB_JOB_PATH="/tmp/aurora_hub_jobs"
# Editable inputs + engine-derived tokens. The list ships as a data file
# generated by scripts/sync-tokens.mjs from the theme's token spec, alongside
# the preset templates emitted from the same registry, so template contents and
# this validation list cannot drift apart. expected_count below derives from it
# (count * 2 for light_/dark_).
readonly COLOR_TOKEN_KEYS="$(grep -v '^#' "$COLOR_TOKENS_FILE" 2>/dev/null)"

# Number of color options a valid preset template must contain (every token in
# both light_ and dark_ variants). Derived once from COLOR_TOKEN_KEYS.
PRESET_EXPECTED_COUNT=$(( $(printf '%s\n' $COLOR_TOKEN_KEYS | grep -c .) * 2 ))

# Shared gate for uploaded tmp files: size cap, per-kind content checks,
# and tmp cleanup on every rejection. Callers get return 0 only when the
# tmp file is safe to move into place; on failure the JSON error has
# already been emitted, so call sites just `|| exit 0`.
receive_upload() {
	ru_tmp="$1"; ru_kind="$2"; ru_name="$3"
	[ -f "$ru_tmp" ] || {
		echo '{ "result": 1, "error": "No uploaded file" }'; return 1; }
	ru_size=$(wc -c < "$ru_tmp")
	[ "$ru_size" -le "$MAX_UPLOAD" ] || {
		rm -f "$ru_tmp"
		echo '{ "result": 1, "error": "File exceeds 8MB limit" }'; return 1; }
	case "$ru_kind" in
	font)
		[ "$(head -c 4 "$ru_tmp")" = "wOF2" ] || {
			rm -f "$ru_tmp"
			echo '{ "result": 1, "error": "Not a woff2 file" }'; return 1; }
		;;
	image)
		case "$ru_name" in
		""|*/*|*..*)
			rm -f "$ru_tmp"
			echo '{ "result": 255 }'; return 1 ;;
		esac
		ru_ext=$(printf '%s' "$ru_name" | sed 's/.*\.//' | tr 'A-Z' 'a-z')
		case "$ru_ext" in
		jpg|jpeg|png|webp|avif|svg|gif|ico) ;;
		*)
			rm -f "$ru_tmp"
			echo '{ "result": 1, "error": "Unsupported image type" }'; return 1 ;;
		esac
		;;
	*)
		rm -f "$ru_tmp"
		echo '{ "result": 1, "error": "Unknown upload kind" }'; return 1 ;;
	esac
	return 0
}

# Fail fast when the shipped key list is missing or empty: with zero keys the
# expected-count check degrades to 0==0, so preset/import validation would
# vacuously succeed while writing no color keys at all. Called by every method
# that consumes COLOR_TOKEN_KEYS before it validates anything.
require_color_token_keys() {
	[ "$PRESET_EXPECTED_COUNT" -gt 0 ]
}

# Populated by load_preset_snapshot() with newline-separated "key=value" pairs
# for the requested preset; reused for both validation and emission so the
# template is parsed a single time.
PRESET_SNAPSHOT=""

# The layout and typography half of a preset. A built-in preset is a whole
# look, not a palette: navigation shape, spacing, corner radius, content width
# and both font stacks travel with the colours, exactly the fields
# validate_and_apply_hub_payload accepts from a shared configuration. Keeping
# the two lists identical is what makes "apply this theme" mean the same thing
# whether the theme came off the disk or off the hub.
readonly PRESET_STRUCT_KEYS="nav_type toolbar_enabled struct_spacing struct_radius_base struct_content_width_centered struct_font_sans struct_font_mono"

normalize_preset_name() {
	local name="${1:-default}"

	case "$name" in
	classic) echo "default" ;;
	*) echo "$name" ;;
	esac
}

resolve_preset_path() {
	case "$(normalize_preset_name "$1")" in
	default) echo "$DEFAULT_TEMPLATE" ;;
	sage-green) echo "$SAGE_GREEN_TEMPLATE" ;;
	amber-sand) echo "$AMBER_SAND_TEMPLATE" ;;
	monochrome) echo "$MONOCHROME_TEMPLATE" ;;
	sky-blue) echo "$SKY_BLUE_TEMPLATE" ;;
	*) return 1 ;;
	esac
}

is_safe_color_value() {
	case "$1" in
	*[\;{}\<\>]*) return 1 ;;
	esac
	printf '%s' "$1" | LC_ALL=C grep -q '[[:cntrl:]]' && return 1
	return 0
}

is_color_token_key() {
	local candidate="$1" token

	for token in $COLOR_TOKEN_KEYS; do
		[ "$candidate" = "$token" ] && return 0
	done
	return 1
}

# Pull the PRESET_STRUCT_KEYS options out of a template as "key=value" lines,
# then validate each one against the very bounds
# validate_and_apply_hub_payload enforces on an inbound hub configuration --
# a preset that could write a spacing the hub would reject would mean this
# package held two different definitions of a valid look.
#
# Every key is required. A template missing one is a broken install rather than
# an older preset (all five ship from this same repo), and half a look applied
# over the previous one is worse than a visible failure.
load_preset_struct_snapshot() {
	local template="$1"
	local snapshot key value
	local nav_type="" toolbar_enabled="" spacing="" radius="" width=""
	local font_sans="" font_mono=""

	snapshot=$(awk -v keys="$PRESET_STRUCT_KEYS" '
		BEGIN {
			n = split(keys, a, /[ \t\n]+/)
			for (i = 1; i <= n; i++) if (a[i] != "") want[a[i]] = 1
		}
		/^[ \t]*option[ \t]+/ {
			key = $2
			if (!(key in want) || (key in seen)) next
			seen[key] = 1
			val = substr($0, index($0, key) + length(key))
			sub(/^[ \t]+/, "", val)
			sub(/[ \t]+$/, "", val)
			if (val ~ /^'\''.*'\''$/ || val ~ /^".*"$/)
				val = substr(val, 2, length(val) - 2)
			print key "=" val
		}
	' "$template") || return 1

	while IFS='=' read -r key value; do
		case "$key" in
		nav_type) nav_type="$value" ;;
		toolbar_enabled) toolbar_enabled="$value" ;;
		struct_spacing) spacing="$value" ;;
		struct_radius_base) radius="$value" ;;
		struct_content_width_centered) width="$value" ;;
		struct_font_sans) font_sans="$value" ;;
		struct_font_mono) font_mono="$value" ;;
		esac
	done <<-EOF
	$snapshot
	EOF

	case "$nav_type" in mega-menu|dropdown|sidebar) ;; *) return 1 ;; esac
	case "$toolbar_enabled" in 0|1) ;; *) return 1 ;; esac

	printf '%s' "$spacing" | grep -Eq '^[0-9]+(\.[0-9]+)?rem$' || return 1
	awk -v v="${spacing%rem}" 'BEGIN{ if (v+0<0.05 || v+0>1) exit 1 }' || return 1

	printf '%s' "$radius" | grep -Eq '^[0-9]+(\.[0-9]+)?rem$' || return 1
	awk -v v="${radius%rem}" 'BEGIN{ if (v+0<0 || v+0>2) exit 1 }' || return 1

	printf '%s' "$width" | grep -Eq '^[0-9]+(\.[0-9]+)?rem$' || return 1
	awk -v v="${width%rem}" 'BEGIN{ if (v+0<40 || v+0>160) exit 1 }' || return 1

	# The stacks are written into a single-quoted `uci batch` line, so a
	# literal quote in one would break out of it; is_valid_font_stack rejects
	# that along with control characters, over-long values and any character
	# outside a font stack's alphabet.
	is_valid_font_stack "$font_sans" || return 1
	is_valid_font_stack "$font_mono" || return 1

	printf '%s\n' "$snapshot"
	return 0
}

# Parse a preset template into PRESET_SNAPSHOT ("key=value" lines) with a single
# awk pass. awk validates every option in one shot: the token must be known, the
# value must be injection-safe, and the count must match PRESET_EXPECTED_COUNT.
# This replaces the previous approach of spawning one `uci get` per token (plus a
# grep per value), which was ~120 subprocesses on the page-load path.
#
# The layout/typography options are appended by load_preset_struct_snapshot, so
# the caller writes one flat list of "key=value" pairs and cannot apply a
# preset's colours without the look they were designed against.
load_preset_snapshot() {
	local template="$1"
	local struct

	PRESET_SNAPSHOT=""
	[ -f "$template" ] || return 1
	grep -Eq "^config[[:space:]]+aurora" "$template" 2>/dev/null || return 1

	PRESET_SNAPSHOT=$(awk -v tokens="$COLOR_TOKEN_KEYS" -v expected="$PRESET_EXPECTED_COUNT" '
		BEGIN {
			n = split(tokens, a, /[ \t\n]+/)
			for (i = 1; i <= n; i++) if (a[i] != "") valid[a[i]] = 1
		}
		/^[ \t]*option[ \t]+(light|dark)_/ {
			key = $2
			val = substr($0, index($0, key) + length(key))
			sub(/^[ \t]+/, "", val)
			sub(/[ \t]+$/, "", val)
			if (val ~ /^'\''.*'\''$/ || val ~ /^".*"$/)
				val = substr(val, 2, length(val) - 2)
			tok = key
			sub(/^(light|dark)_/, "", tok)
			if (!(tok in valid)) next
			if (val ~ /[;{}<>]/ || val ~ /[[:cntrl:]]/) { bad = 1; exit 1 }
			print key "=" val
			count++
		}
		END { if (bad || count != expected + 0) exit 1 }
	' "$template") || { PRESET_SNAPSHOT=""; return 1; }

	struct=$(load_preset_struct_snapshot "$template") || { PRESET_SNAPSHOT=""; return 1; }
	PRESET_SNAPSHOT="$PRESET_SNAPSHOT
$struct"

	return 0
}

validate_import_color_options() {
	local import_dir option_name mode token value

	import_dir=$(mktemp -d /tmp/aurora-import.XXXXXX) || return 1
	cp "$IMPORT_CONFIG_TMP" "$import_dir/aurora" || {
		rm -rf "$import_dir"
		return 1
	}

	while IFS= read -r option_name; do
		[ -n "$option_name" ] || continue
		case "$option_name" in
		light_*) mode="light"; token="${option_name#light_}" ;;
		dark_*) mode="dark"; token="${option_name#dark_}" ;;
		*) continue ;;
		esac

		is_color_token_key "$token" || {
			rm -rf "$import_dir"
			return 1
		}

		value=$(uci -c "$import_dir" -q get "aurora.theme.${mode}_${token}") || {
			rm -rf "$import_dir"
			return 1
		}
		is_safe_color_value "$value" || {
			rm -rf "$import_dir"
			return 1
		}
	done <<-EOF
	$(uci -c "$import_dir" -q show aurora.theme \
		| sed -n 's/^aurora\.theme\.\([^=]*\)=.*/\1/p')
	EOF

	rm -rf "$import_dir"
	return 0
}

list_font_entries() {
	local slot_filter="$1"

	[ -r "$FONT_PRESETS_FILE" ] || return 1

	while IFS='|' read -r kind slot name label source family stack; do
		[ "$kind" = "font" ] || continue
		[ -n "$name" ] || continue
		[ -n "$slot_filter" ] && [ "$slot" != "$slot_filter" ] && continue
		printf '%s|%s|%s|%s|%s|%s\n' \
			"$slot" "$name" "$label" "$source" "$family" "$stack"
	done < "$FONT_PRESETS_FILE"
}

# Emit "weight|sha256|url_primary|url_fallback" lines for one preset.
list_font_files() {
	local slot="$1" name="$2" kind fslot fname weight sha256 url1 url2

	[ -r "$FONT_PRESETS_FILE" ] || return 1

	while IFS='|' read -r kind fslot fname weight sha256 url1 url2; do
		[ "$kind" = "file" ] || continue
		[ "$fslot" = "$slot" ] && [ "$fname" = "$name" ] || continue
		printf '%s|%s|%s|%s\n' "$weight" "$sha256" "$url1" "$url2"
	done < "$FONT_PRESETS_FILE"
}



# Memoised in $_pkg_manager: get_init_data asks twice (feed status and installed
# versions) and each `$(...)` is its own fork. Callers read the variable after
# calling; nothing is echoed.
_pkg_manager=""
detect_package_manager() {
	[ -n "$_pkg_manager" ] && return
	# Decide from the on-disk database, exactly as install.sh does. Probing for
	# binaries can answer differently on the same machine (both can be present
	# during migration), and the two paths must never disagree about what this
	# device is.
	if [ -f /lib/apk/db/installed ]; then _pkg_manager="apk"
	elif [ -f /usr/lib/opkg/status ]; then _pkg_manager="opkg"
	else _pkg_manager="unknown"; fi
}

get_system_lang() {
	local lang=""
	if [ -f /etc/config/luci ]; then
		lang=$(uci -q get luci.main.lang)
	fi
	[ -z "$lang" ] && lang="zh-cn"
	[ "$lang" = "auto" ] && lang="zh-cn"
	echo "$lang"
}

update_icon_cache_timestamp() {
	local timestamp=$(date +%s)
	uci -q set aurora.theme.icon_cache_version="$timestamp"
	uci -q commit aurora
}

cleanup_custom_fonts() {
	local slot="$1"
	mkdir -p "$FONT_PATH"
	if [ -n "$slot" ]; then
		rm -f "$FONT_PATH"/aurora-font-${slot}-*.woff2 \
		      "$FONT_PATH"/aurora-font-${slot}-*.tmp \
		      "$FONT_PATH"/aurora-font-${slot}.remote.* \
		      "$FONT_PATH"/aurora-font-${slot}-*.face \
		      "$FONT_PATH/aurora-font-${slot}.css" \
		      "$FONT_PATH/aurora-font-${slot}.face" \
		      "$FONT_PATH/aurora-font-${slot}.face.tmp" \
		      "$FONT_PATH/aurora-font-${slot}.preset" 2>/dev/null
	else
		rm -f "$FONT_PATH"/aurora-font-sans-*.woff2 \
		      "$FONT_PATH"/aurora-font-mono-*.woff2 \
		      "$FONT_PATH"/aurora-font-sans-*.tmp \
		      "$FONT_PATH"/aurora-font-mono-*.tmp \
		      "$FONT_PATH"/aurora-font-sans.remote.* \
		      "$FONT_PATH"/aurora-font-mono.remote.* \
		      "$FONT_PATH"/aurora-font-sans.css \
		      "$FONT_PATH"/aurora-font-mono.css \
		      "$FONT_PATH"/aurora-font-sans.face \
		      "$FONT_PATH"/aurora-font-mono.face \
		      "$FONT_PATH"/aurora-font-sans.face.tmp \
		      "$FONT_PATH"/aurora-font-mono.face.tmp \
		      "$FONT_PATH"/aurora-font-sans.preset \
		      "$FONT_PATH"/aurora-font-mono.preset 2>/dev/null
		rm -f "$FONT_PATH/preload.txt" 2>/dev/null
	fi
}

fetch_url() {
	local output="$1"
	shift
	local tries_arg=""
	# A caller that needs to tell a 404 apart from a dead network sets
	# FETCH_URL_ERR to a file to collect stderr, which also drops -q --
	# -q silences the very line that names the status. Everyone else stays
	# quiet and throws stderr away, which is what the asset-download loop
	# wants: it fetches many files and its progress meters have nowhere to go
	# but rpcd's stderr.
	local quiet="-q" err="/dev/null"
	[ -n "$FETCH_URL_ERR" ] && { quiet=""; err="$FETCH_URL_ERR"; }

	if wget --help 2>&1 | grep -q -- '--tries'; then
		tries_arg="--tries=1"
	fi

	if command -v timeout >/dev/null 2>&1; then
		timeout 12 wget $quiet -O "$output" --timeout=8 $tries_arg "$@" 2>"$err"
	else
		wget $quiet -O "$output" --timeout=8 $tries_arg "$@" 2>"$err"
	fi
}

# Ensures the device's hub identity exists: device.key (0600) is the secret
# device_token used to authenticate share/update/delete calls; device.hash
# (0644) is an anonymous device_hash used only for download dedup and carries
# no authority. Both are 64 hex chars. Sets DEVICE_TOKEN/DEVICE_HASH for the
# caller.
ensure_device_identity() {
	mkdir -p "$DEVICE_DIR"
	if [ ! -s "$DEVICE_DIR/device.key" ]; then
		head -c32 /dev/urandom | hexdump -v -e '/1 "%02x"' > "$DEVICE_DIR/device.key"
		chmod 600 "$DEVICE_DIR/device.key"
	fi
	if [ ! -s "$DEVICE_DIR/device.hash" ]; then
		head -c32 /dev/urandom | hexdump -v -e '/1 "%02x"' > "$DEVICE_DIR/device.hash"
		chmod 644 "$DEVICE_DIR/device.hash"
	fi
	DEVICE_TOKEN=$(cat "$DEVICE_DIR/device.key")
	DEVICE_HASH=$(cat "$DEVICE_DIR/device.hash")
}

# "This one is gone" and "the store is down" are different things to tell a
# user, and uclient-fetch hands its caller neither: exit 8 covers every error
# status the hub can send, and -q silences the one line that names which. So
# the three helpers below keep stderr and read the status off it. Measured on
# the device against the live hub: a 404 exits 8 and prints "HTTP error 404";
# a host it cannot reach exits 4 and prints "Failed to send request". The
# wording is uclient-fetch's own fixed format, not the hub's -- a device
# carrying busybox wget instead prints something else, misses the match, and
# degrades to the network answer, which is what it reported before anyway.
hub_http_gone() {  # $1=stderr_file
	grep -q '^HTTP error 404$' "$1" 2>/dev/null
}

# Returns 2, not 1, when the store has no such config any more, so the apply
# path can say "this theme is gone" instead of blaming the network. fetch_url
# stays the transport: it carries the --tries shim the asset downloads rely on.
hub_http_get() {  # $1=path
	local out err rc; out=$(mktemp); err=$(mktemp)
	FETCH_URL_ERR="$err"
	fetch_url "$out" "$HUB_BASE$1"
	rc=$?
	FETCH_URL_ERR=""
	if [ "$rc" = 0 ]; then
		cat "$out"
	elif hub_http_gone "$err"; then
		rc=2
	else
		rc=1
	fi
	rm -f "$out" "$err"
	return "$rc"
}

hub_http_post() {  # $1=path  $2=body_file
	local out; out=$(mktemp)
	# uclient-fetch/wget on OpenWrt: --post-file + --header both supported
	if timeout 15 wget -qO "$out" --timeout=12 \
	     --header='Content-Type: application/json' \
	     --post-file="$2" "$HUB_BASE$1"; then
		cat "$out"; rm -f "$out"; return 0
	fi
	rm -f "$out"; return 1
}

# Mirrors hub_http_post for the update path, with one difference that is easy
# to get wrong: --post-file *selects* the POST method, so pairing it with
# --method is a contradiction that uclient-fetch rejects outright -- it prints
# its usage and exits non-zero, which hub_http_put can only report as
# hub_unreachable. The body flag that goes with --method is --body-file.
# Verified on the device: with --body-file the hub answers
# {"id":"...","removed":true}; with the POST-selecting flag instead, wget only
# prints its usage. Update and delete never once worked before this.
#
# Returns 2, not 1, when the hub has no such share any more (see hub_http_gone).
hub_http_put() {  # $1=path  $2=body_file
	local out err rc; out=$(mktemp); err=$(mktemp)
	timeout 15 wget -O "$out" --timeout=12 \
	     --header='Content-Type: application/json' \
	     --method=PUT --body-file="$2" "$HUB_BASE$1" 2>"$err"
	rc=$?
	if [ "$rc" = 0 ]; then
		cat "$out"
	elif hub_http_gone "$err"; then
		rc=2
	else
		rc=1
	fi
	rm -f "$out" "$err"
	return "$rc"
}

# Same --method/--body-file pairing and the same 0/2/1 contract as
# hub_http_put above; the hub expects the device_token in a JSON body even on
# DELETE.
hub_http_delete() {  # $1=path  $2=body_file
	local out err rc; out=$(mktemp); err=$(mktemp)
	timeout 15 wget -O "$out" --timeout=12 \
	     --header='Content-Type: application/json' \
	     --method=DELETE --body-file="$2" "$HUB_BASE$1" 2>"$err"
	rc=$?
	if [ "$rc" = 0 ]; then
		cat "$out"
	elif hub_http_gone "$err"; then
		rc=2
	else
		rc=1
	fi
	rm -f "$out" "$err"
	return "$rc"
}

# Minimal JSON string escaper for values that have already been rejected
# outright on any control character (has_control_char must run first): this
# only escapes the two characters JSON forbids unescaped in a string --
# backslash and double-quote -- so free-text fields (name/author/description)
# can be spliced into a hand-assembled request body alongside pre-built JSON
# fragments (payload/assets) that jshn has no way to re-embed as raw values
# once they are already serialized text.
json_escape_string() {
	printf '%s' "$1" | sed 's/\\/\\\\/g; s/"/\\"/g'
}

# Mirrors write_font_job_status: write-tmp-then-mv so a concurrent
# get_hub_status read never observes a half-written status file. Also prunes
# status files older than an hour on every write -- /tmp/aurora_hub_jobs is
# never otherwise cleaned up, and marketplace.js triggers a hub_apply (and thus a
# new job_id/status file) on every apply attempt.
write_hub_job_status() {
	local job_id="$1" state="$2" step="$3" error="$4"
	local status_file="$HUB_JOB_PATH/$job_id.status"

	mkdir -p "$HUB_JOB_PATH"
	{
		printf "state='%s'\n" "$state"
		printf "step='%s'\n" "$step"
		printf "error='%s'\n" "$error"
	} > "$status_file.tmp"
	mv "$status_file.tmp" "$status_file"
	find "$HUB_JOB_PATH" -name '*.status' -mmin +60 -delete 2>/dev/null
}

# Maps a hub asset "kind" to the local filename it is written to under
# ICON_PATH. Unknown kinds return failure so the caller skips them instead
# of aborting the whole apply -- one bad/unexpected asset must never undo
# config data that has already been validated and committed.
hub_asset_target_name() {  # $1=kind  $2=sha256  $3=url
	local kind="$1" sha256="$2" url="$3" ext

	case "$kind" in
	logo_svg) printf '%s' "logo.svg"; return 0 ;;
	favicon_png) printf '%s' "favicon.png"; return 0 ;;
	favicon_ico) printf '%s' "favicon.ico"; return 0 ;;
	pwa_icon_192) printf '%s' "app-icon-192x192.png"; return 0 ;;
	pwa_icon_512) printf '%s' "app-icon-512x512.png"; return 0 ;;
	login_bg)
		ext=$(printf '%s' "$url" | sed -n 's/.*\.\([A-Za-z0-9]\{1,5\}\)$/\1/p' | tr 'A-Z' 'a-z')
		case "$ext" in jpg|jpeg|png|webp|avif|gif) ;; *) ext="jpg" ;; esac
		printf 'hub-login-bg-%.12s.%s' "$sha256" "$ext"
		return 0
		;;
	*) return 1 ;;
	esac
}

# Maps a hub asset "kind" to the aurora.theme uci option that must point at
# the applied filename for the asset to actually take effect -- theme.js
# reads these options to render the configured image, it does not infer
# anything from ICON_PATH's contents. login_bg is handled separately by the
# caller (its value is a url('...') wrapper, not a bare filename).
hub_asset_uci_option() {  # $1=kind
	case "$1" in
	logo_svg) printf '%s' "logo_svg" ;;
	favicon_png) printf '%s' "favicon_png" ;;
	favicon_ico) printf '%s' "favicon_ico" ;;
	pwa_icon_192) printf '%s' "pwa_icon_192" ;;
	pwa_icon_512) printf '%s' "pwa_icon_512" ;;
	*) return 1 ;;
	esac
}

# Fetches+verifies one hub image asset to a temp file beside its target, and
# only on success backs up the current live file (if any) under
# $DEVICE_DIR/pre-hub-images/ before mv'ing the verified download onto the
# target. fetch_verified rm's *its own dest* on a checksum mismatch, so it
# must never be pointed directly at the live shipped-default file -- a
# corrupt/mismatched hub asset would otherwise delete a factory default
# (logo.svg etc.) with nothing to fall back to. On any failure the live file
# is left completely untouched and the asset is simply skipped, matching the
# existing "one bad asset never undoes validated config" posture. On success
# the corresponding aurora.theme uci option is pointed at the new filename
# (login_bg instead gets its struct_login_bg url('...') form) so the applied
# asset is actually used, and committed immediately (assets are independent
# of the already-committed color/layout/typography batch).
apply_hub_asset() {  # $1=target_path  $2=sha256  $3=url  $4=kind
	local target_path="$1" sha256="$2" url="$3" kind="$4"
	local tmp_path="${target_path}.hubtmp" backup_dir="$DEVICE_DIR/pre-hub-images" opt

	rm -f "$tmp_path"
	fetch_verified "$tmp_path" "$sha256" "$url" "" || {
		rm -f "$tmp_path"
		return 1
	}

	if [ -f "$target_path" ]; then
		mkdir -p "$backup_dir"
		cp -p "$target_path" "$backup_dir/${target_path##*/}" 2>/dev/null
	fi

	mv "$tmp_path" "$target_path" 2>/dev/null || {
		rm -f "$tmp_path"
		return 1
	}
	chmod 644 "$target_path" 2>/dev/null

	if [ "$kind" = "login_bg" ]; then
		uci -q set aurora.theme.struct_login_bg="url('/luci-static/aurora/images/${target_path##*/}')"
		uci -q commit aurora
	elif opt=$(hub_asset_uci_option "$kind"); then
		uci -q set "aurora.theme.$opt=${target_path##*/}"
		uci -q commit aurora
	fi
	return 0
}

# Restores every image hub_apply_worker backed up (see apply_hub_asset)
# before overwriting it, copying each back onto its live ICON_PATH filename,
# then clears the backup directory -- a later restore must not re-apply
# images from an even-earlier apply. Companion to hub_restore_backup's
# /etc/config/aurora restore, which on its own left applied images in place.
restore_pre_hub_images() {
	local backup_dir="$DEVICE_DIR/pre-hub-images" f

	[ -d "$backup_dir" ] || return 0
	for f in "$backup_dir"/*; do
		[ -f "$f" ] || continue
		cp -p "$f" "$ICON_PATH/${f##*/}" 2>/dev/null
		chmod 644 "$ICON_PATH/${f##*/}" 2>/dev/null
	done
	rm -rf "$backup_dir"
}

# Reverse-maps a locally-applied font stack back to the hub's preset id: the
# hub payload's typography.font_sans/font_mono fields are informational
# preset ids (not stacks), so sharing has to recover "geist-sans" from
# whatever CSS stack struct_font_$slot currently holds. No match (custom
# uploaded font, or a stack that predates the roster) collapses to "default"
# -- v1 never shares the custom woff2 itself, only the id it resolves to.
resolve_font_preset_id() {
	local slot="$1" stack preset

	stack=$(uci -q get "aurora.theme.struct_font_$slot")
	if [ -n "$stack" ] && [ -r "$FONT_PRESETS_FILE" ]; then
		preset=$(awk -F'|' -v s="$slot" -v k="$stack" '$1=="font"&&$2==s&&$7==k{print $3;exit}' "$FONT_PRESETS_FILE" 2>/dev/null)
	fi
	printf '%s' "${preset:-default}"
}

# Looks up the canonical (roster-authored) font stack for a given slot+preset
# id -- field 7 of its "font" row in font-presets.conf. Used as the fallback
# value when a locally-stored struct_font_$slot fails the hub's own
# typography regex (e.g. a hand-edited uci config), since every roster stack
# is authored to already satisfy that regex.
font_preset_stack() {
	local slot="$1" preset="$2"

	[ -r "$FONT_PRESETS_FILE" ] || return 1
	awk -F'|' -v s="$slot" -v n="$preset" '$1=="font"&&$2==s&&$3==n{print $7;exit}' "$FONT_PRESETS_FILE" 2>/dev/null
}

# True (0) when $1 is a non-empty string that satisfies the hub's
# struct_font_sans/struct_font_mono contract: <=200 chars, no control
# characters, and matching ^[A-Za-z0-9 ,"'-]+$ -- the same rule
# validate_and_apply_hub_payload enforces on the inbound side. A locally
# stored stack that fails this (most likely a hand-edited uci config, since
# every value this package itself ever writes -- preset stacks and
# `"$family", $default_stack` for custom uploads -- already conforms) must
# never be shared verbatim: the hub would otherwise reject the entire share.
# Also rejects a literal single quote even though the hub's own regex above
# permits one: validate_and_apply_hub_payload additionally rejects it on the
# apply side (see has_batch_unsafe_char), so sharing a stack containing one
# verbatim would only ever produce a share that fails to re-apply -- falling
# back to the canonical preset stack here (same as any other regex failure)
# keeps both sides consistent.
is_valid_font_stack() {
	local v="$1"

	[ -n "$v" ] || return 1
	[ "${#v}" -le 200 ] || return 1
	has_control_char "$v" && return 1
	case "$v" in *\'*) return 1 ;; esac
	printf '%s' "$v" | grep -Eq '^[A-Za-z0-9 ,"'\''-]+$'
}

# Assembles the current /etc/config/aurora into the hub's strict payload
# schema and writes it to $1 (colors/layout/typography/toolbar/assets, no
# device_token/name -- those are the caller's job). Custom, non-default image
# assets are additionally base64-encoded and appended, one JSON object per
# line, to "$1.b64" for the caller to splice into the share/update request's
# top-level "assets" array; the payload's own "assets" entries carry only
# {kind,sha256,size} per the hub schema. v1 never ships font assets --
# typography.font_sans/font_mono are resolve_font_preset_id ids only.
build_share_payload() {
	local out_file="$1" b64_file="${1}.b64"
	local token prefix key value
	local sid title url icon enabled tcount trimmed_title tlen
	local kind fname file sha256 size b64
	local font_sans_id font_mono_id struct_font_sans struct_font_mono

	require_color_token_keys || return 1

	: > "$b64_file"

	json_init
	json_add_int "schema" 1
	json_add_string "theme" "aurora"

	json_add_object "colors"
	for token in $COLOR_TOKEN_KEYS; do
		for prefix in light dark; do
			key="${prefix}_${token}"
			value=$(uci -q get "aurora.theme.$key")
			json_add_string "$key" "$value"
		done
	done
	json_close_object

	json_add_object "layout"
	json_add_string "nav_type" "$(uci -q get aurora.theme.nav_type)"
	json_add_string "struct_spacing" "$(uci -q get aurora.theme.struct_spacing)"
	json_add_string "struct_radius_base" "$(uci -q get aurora.theme.struct_radius_base)"
	json_add_string "struct_content_width_centered" "$(uci -q get aurora.theme.struct_content_width_centered)"
	json_add_string "toolbar_enabled" "$(uci -q get aurora.theme.toolbar_enabled)"
	json_close_object

	font_sans_id=$(resolve_font_preset_id sans)
	font_mono_id=$(resolve_font_preset_id mono)
	struct_font_sans=$(uci -q get aurora.theme.struct_font_sans)
	struct_font_mono=$(uci -q get aurora.theme.struct_font_mono)

	# A struct_font_* stack that fails the hub's own regex (only possible via
	# a hand-edited uci config; nothing this package writes can produce one)
	# would otherwise get the whole share rejected by the hub -- fall back to
	# the resolved preset's canonical stack, then to the slot's default stack,
	# so typography always validates.
	if ! is_valid_font_stack "$struct_font_sans"; then
		struct_font_sans=$(font_preset_stack sans "$font_sans_id")
		is_valid_font_stack "$struct_font_sans" || struct_font_sans=$(font_preset_stack sans default)
	fi
	if ! is_valid_font_stack "$struct_font_mono"; then
		struct_font_mono=$(font_preset_stack mono "$font_mono_id")
		is_valid_font_stack "$struct_font_mono" || struct_font_mono=$(font_preset_stack mono default)
	fi

	json_add_object "typography"
	json_add_string "font_sans" "$font_sans_id"
	json_add_string "font_mono" "$font_mono_id"
	json_add_string "struct_font_sans" "$struct_font_sans"
	json_add_string "struct_font_mono" "$struct_font_mono"
	json_close_object

	# Anonymous toolbar_item sections have no stable index, so their uci ids
	# are recovered from `uci show` output rather than iterated by position.
	# The local settings UI (theme.js) does not itself enforce the hub's
	# stricter per-field limits (title 1-30, url <=200 + scheme, icon
	# charset+<=64), so every item is validated here exactly like
	# validate_and_apply_hub_payload validates them on the inbound side --
	# an out-of-range item is skipped (never sent), instead of getting the
	# entire share rejected by the hub. Capped at 12 to match the hub schema.
	json_add_array "toolbar"
	tcount=0
	for sid in $(uci show aurora 2>/dev/null | sed -n 's/^aurora\.\([^.=]*\)=toolbar_item$/\1/p'); do
		[ "$tcount" -ge 12 ] && break
		title=$(uci -q get "aurora.$sid.title")
		url=$(uci -q get "aurora.$sid.url")
		icon=$(uci -q get "aurora.$sid.icon")
		enabled=$(uci -q get "aurora.$sid.enabled")

		trimmed_title=$(printf '%s' "$title" | tr -d '[:cntrl:]')
		tlen=${#trimmed_title}
		[ "$tlen" -ge 1 ] && [ "$tlen" -le 30 ] || continue
		# validate_and_apply_hub_payload rejects a literal quote in a title
		# outright (see has_batch_unsafe_char); skip such an item here too,
		# same posture as any other out-of-range item, instead of sharing a
		# config that would fail to re-apply on the receiving end.
		case "$trimmed_title" in *\'*) continue ;; esac

		has_control_char "$url" && continue
		case "$url" in
		//*) continue ;;
		http://*|https://*|/*) ;;
		*) continue ;;
		esac
		[ "${#url}" -le 200 ] || continue

		if [ -n "$icon" ]; then
			has_control_char "$icon" && continue
			[ "${#icon}" -le 64 ] || continue
			printf '%s' "$icon" | grep -Eq '^[A-Za-z0-9._-]+$' || continue
		fi

		case "$enabled" in 0|1) ;; *) continue ;; esac

		json_add_object ""
		json_add_string "title" "$trimmed_title"
		json_add_string "url" "$url"
		[ -n "$icon" ] && json_add_string "icon" "$icon"
		json_add_string "enabled" "$enabled"
		json_close_object
		tcount=$((tcount + 1))
	done
	json_close_array

	# Only non-default, existing image assets are shared -- an unmodified
	# factory filename means the user never customized that slot, so there is
	# nothing worth uploading (and nothing copyright-risky to check).
	json_add_array "assets"
	for kind in logo_svg favicon_png favicon_ico pwa_icon_192 pwa_icon_512 login_bg; do
		if [ "$kind" = "login_bg" ]; then
			value=$(uci -q get aurora.theme.struct_login_bg)
			fname=$(printf '%s' "$value" | sed "s|url('/luci-static/aurora/images/||;s|')||")
		else
			fname=$(uci -q get "aurora.theme.$kind")
		fi

		[ -n "$fname" ] || continue
		# fname comes straight out of uci (or a login_bg url() capture) and
		# is about to be joined onto $ICON_PATH and read, sha256'd and
		# base64'd for upload to the public hub -- a value containing "/" or
		# ".." (e.g. "../../etc/aurora/device.key") could otherwise escape
		# ICON_PATH and exfiltrate an arbitrary file. Reject outright, same
		# posture as remove_icon's `dirname "$filename" | grep -q "\.\."` guard
		# elsewhere in this file, before $file is ever constructed.
		case "$fname" in
		*/*|*..*) continue ;;
		esac
		case "$fname" in
		logo.svg|favicon.ico|app-icon-192x192.png|app-icon-512x512.png|apple-touch-icon.png)
			continue ;;
		esac

		file="$ICON_PATH/$fname"
		[ -f "$file" ] || continue
		sha256=$(sha256sum "$file" 2>/dev/null | cut -d' ' -f1)
		[ -n "$sha256" ] || continue
		size=$(wc -c < "$file")

		json_add_object ""
		json_add_string "kind" "$kind"
		json_add_string "sha256" "$sha256"
		json_add_int "size" "$size"
		json_close_object

		# BusyBox `base64` has no `-w0`; fall back to unwrapping with `tr`.
		b64=$(base64 -w0 "$file" 2>/dev/null || base64 "$file" 2>/dev/null | tr -d '\n')
		printf '{"kind":"%s","data_b64":"%s"}\n' "$kind" "$b64" >> "$b64_file"
	done
	json_close_array

	json_dump > "$out_file"
	json_cleanup
	return 0
}

# Returns success (0) when $1 contains any control character, INCLUDING a
# newline. This must run before every regex/case check below that uses
# `grep '^...$'` or a case glob: `^`/`$` anchor to line boundaries, not the
# whole string, so a value like "#fff\nset dropbear.@dropbear[0].enable=0"
# would otherwise pass the color regex (first line matches) and then, once
# written as `set aurora.theme.key='<value>'` into the uci-batch script,
# the embedded newline starts a second, attacker-controlled uci command --
# a cross-package injection. Reject, never strip: stripping would silently
# change accepted content instead of failing closed.
has_control_char() {
	case "$1" in *[[:cntrl:]]*) return 0 ;; *) return 1 ;; esac
}

# True (0) when $1 is unsafe to single-quote verbatim into a `uci batch`
# script as `set foo.bar='<value>'`: either a control character (see
# has_control_char) or a literal single quote. `uci batch` parses each line
# as a shell-like command, so a value containing "'" closes the quoted
# argument early -- e.g. a struct_font_sans of `x' network.lan.proto='none`
# turns `set aurora.theme.struct_font_sans='x' network.lan.proto='none'`
# into a 3-arg `set` line that uci silently *skips* (not a cross-package
# injection -- the token can never be the line's sole/first argument -- but
# it defeats the "every field validated or the whole apply fails" contract
# by dropping that field without failing the apply). Both the hub's
# struct_font_*/toolbar-title schema rules otherwise *permit* a literal
# quote, so this must be checked in addition to, not instead of, the format
# regex. Reject outright, matching has_control_char's fail-closed posture.
has_batch_unsafe_char() {
	has_control_char "$1" && return 0
	case "$1" in *\'*) return 0 ;; esac
	return 1
}

# Local, non-trusting validation of a hub theme payload, plus its atomic UCI
# apply. The server is untrusted input: every field is parsed with jshn and
# checked against the same rules the frontend enforces, using only
# case/grep -E (no eval). Nothing is written to UCI until every field in the
# payload has passed; on any violation the function returns non-zero having
# touched no UCI state at all. On success it builds one `uci batch` (colors
# deleted then reset, layout/typography set, toolbar_item sections replaced,
# hub_applied/icon_cache_version bookkeeping), commits, and reverts on
# commit failure.
#
# $1 is the FULL flat hub config body (as returned by hub_http_get -- there
# is no "data" wrapper; that envelope belongs to the frontend and is added
# by hubFetch in htdocs/.../utils/hub-api.js, which never touches this
# path, see hub_apply_worker). The config
# name for hub_applied bookkeeping lives at the body's root ("name"), not
# inside "payload" -- it is read here, before "payload" is ever selected,
# so the caller no longer has to extract and pass it separately.
validate_and_apply_hub_payload() {
	local body_json="$1" hub_name
	local batch_file schema theme
	local key token prefix value
	local nav_type toolbar_enabled
	local struct_spacing struct_radius_base struct_content_width_centered
	local font_sans font_mono struct_font_sans struct_font_mono
	local color_keys color_key_count=0 k
	local i title url icon enabled tcount trimmed_title tlen
	local toolbar_section_count

	json_load "$body_json" 2>/dev/null || return 1

	# hub_applied is server-supplied free text too, and is written the same
	# single-quoted uci-batch way as every other field below -- guard it the
	# same way (control chars AND a literal quote, see has_batch_unsafe_char)
	# before it ever reaches the batch. Read at the body's root, before
	# "payload" is selected.
	json_get_var hub_name "name"
	has_batch_unsafe_char "$hub_name" && { json_cleanup; return 1; }

	json_select payload 2>/dev/null || { json_cleanup; return 1; }

	json_get_var schema "schema"
	[ "$schema" = "1" ] || { json_cleanup; return 1; }
	json_get_var theme "theme"
	[ "$theme" = "aurora" ] || { json_cleanup; return 1; }

	require_color_token_keys || { json_cleanup; return 1; }

	batch_file=$(mktemp) || return 1

	# --- colors: exactly the 62 light_/dark_ keys, each a valid hex color ---
	json_select colors 2>/dev/null || { rm -f "$batch_file"; return 1; }
	json_get_keys color_keys
	for k in $color_keys; do color_key_count=$((color_key_count + 1)); done
	if [ "$color_key_count" -ne "$PRESET_EXPECTED_COUNT" ]; then
		rm -f "$batch_file"; return 1
	fi
	for token in $COLOR_TOKEN_KEYS; do
		for prefix in light dark; do
			key="${prefix}_${token}"
			json_get_var value "$key" 2>/dev/null
			[ -n "$value" ] || { rm -f "$batch_file"; return 1; }
			has_control_char "$value" && { rm -f "$batch_file"; return 1; }
			printf '%s' "$value" | grep -Eqi '^#([0-9a-f]{3,4}|[0-9a-f]{6}|[0-9a-f]{8})$' || {
				rm -f "$batch_file"; return 1; }
			printf "set aurora.theme.%s='%s'\n" "$key" "$value" >> "$batch_file"
		done
	done
	json_select ..

	# --- layout: enum nav_type/toolbar_enabled, bounded rem lengths ---
	json_select layout 2>/dev/null || { rm -f "$batch_file"; return 1; }
	json_get_var nav_type "nav_type"
	case "$nav_type" in mega-menu|dropdown|sidebar) ;; *) rm -f "$batch_file"; return 1 ;; esac

	json_get_var toolbar_enabled "toolbar_enabled"
	case "$toolbar_enabled" in 0|1) ;; *) rm -f "$batch_file"; return 1 ;; esac

	json_get_var struct_spacing "struct_spacing"
	has_control_char "$struct_spacing" && { rm -f "$batch_file"; return 1; }
	printf '%s' "$struct_spacing" | grep -Eq '^[0-9]+(\.[0-9]+)?rem$' \
		|| { rm -f "$batch_file"; return 1; }
	awk -v v="${struct_spacing%rem}" 'BEGIN{ if (v+0<0.05 || v+0>1) exit 1 }' \
		|| { rm -f "$batch_file"; return 1; }

	json_get_var struct_radius_base "struct_radius_base"
	has_control_char "$struct_radius_base" && { rm -f "$batch_file"; return 1; }
	printf '%s' "$struct_radius_base" | grep -Eq '^[0-9]+(\.[0-9]+)?rem$' \
		|| { rm -f "$batch_file"; return 1; }
	awk -v v="${struct_radius_base%rem}" 'BEGIN{ if (v+0<0 || v+0>2) exit 1 }' \
		|| { rm -f "$batch_file"; return 1; }

	json_get_var struct_content_width_centered "struct_content_width_centered"
	has_control_char "$struct_content_width_centered" && { rm -f "$batch_file"; return 1; }
	printf '%s' "$struct_content_width_centered" | grep -Eq '^[0-9]+(\.[0-9]+)?rem$' \
		|| { rm -f "$batch_file"; return 1; }
	awk -v v="${struct_content_width_centered%rem}" 'BEGIN{ if (v+0<40 || v+0>160) exit 1 }' \
		|| { rm -f "$batch_file"; return 1; }

	printf "set aurora.theme.nav_type='%s'\n" "$nav_type" >> "$batch_file"
	printf "set aurora.theme.toolbar_enabled='%s'\n" "$toolbar_enabled" >> "$batch_file"
	printf "set aurora.theme.struct_spacing='%s'\n" "$struct_spacing" >> "$batch_file"
	printf "set aurora.theme.struct_radius_base='%s'\n" "$struct_radius_base" >> "$batch_file"
	printf "set aurora.theme.struct_content_width_centered='%s'\n" \
		"$struct_content_width_centered" >> "$batch_file"
	json_select ..

	# --- typography: enum font stacks (informational) + char-limited stacks ---
	json_select typography 2>/dev/null || { rm -f "$batch_file"; return 1; }
	json_get_var font_sans "font_sans"
	case "$font_sans" in default|system|geist-sans|nunito|space-grotesk) ;; \
		*) rm -f "$batch_file"; return 1 ;; esac
	json_get_var font_mono "font_mono"
	case "$font_mono" in default|jetbrains-mono|maple-mono|fira-code|cascadia-code) ;; \
		*) rm -f "$batch_file"; return 1 ;; esac

	json_get_var struct_font_sans "struct_font_sans"
	[ -n "$struct_font_sans" ] && [ "${#struct_font_sans}" -le 200 ] \
		|| { rm -f "$batch_file"; return 1; }
	has_control_char "$struct_font_sans" && { rm -f "$batch_file"; return 1; }
	printf '%s' "$struct_font_sans" | grep -Eq '^[A-Za-z0-9 ,"'\''-]+$' \
		|| { rm -f "$batch_file"; return 1; }
	# The hub's own regex above permits a literal single quote; reject it
	# anyway before it is single-quoted into the uci batch below (see
	# has_batch_unsafe_char).
	case "$struct_font_sans" in *\'*) rm -f "$batch_file"; return 1 ;; esac

	json_get_var struct_font_mono "struct_font_mono"
	[ -n "$struct_font_mono" ] && [ "${#struct_font_mono}" -le 200 ] \
		|| { rm -f "$batch_file"; return 1; }
	has_control_char "$struct_font_mono" && { rm -f "$batch_file"; return 1; }
	printf '%s' "$struct_font_mono" | grep -Eq '^[A-Za-z0-9 ,"'\''-]+$' \
		|| { rm -f "$batch_file"; return 1; }
	case "$struct_font_mono" in *\'*) rm -f "$batch_file"; return 1 ;; esac

	# font_sans/font_mono are informational preset ids only -- not applied to
	# UCI. Only the resolved struct_font_* stacks are.
	printf "set aurora.theme.struct_font_sans='%s'\n" "$struct_font_sans" >> "$batch_file"
	printf "set aurora.theme.struct_font_mono='%s'\n" "$struct_font_mono" >> "$batch_file"
	json_select ..

	# --- toolbar: <=12 items, each field validated ---
	json_select toolbar 2>/dev/null || { rm -f "$batch_file"; return 1; }
	i=1; tcount=0
	while json_select "$i" 2>/dev/null; do
		tcount=$((tcount + 1))
		if [ "$tcount" -gt 12 ]; then
			json_select ..; rm -f "$batch_file"; return 1
		fi

		json_get_var title "title"
		json_get_var url "url"
		json_get_var icon "icon"
		json_get_var enabled "enabled"

		trimmed_title=$(printf '%s' "$title" | tr -d '[:cntrl:]')
		tlen=${#trimmed_title}
		if [ "$tlen" -lt 1 ] || [ "$tlen" -gt 30 ]; then
			json_select ..; rm -f "$batch_file"; return 1
		fi
		# The hub's title schema has no charset restriction beyond length,
		# so a literal single quote is otherwise legal content; reject it
		# here before it is single-quoted into the uci batch below.
		case "$trimmed_title" in
		*\'*) json_select ..; rm -f "$batch_file"; return 1 ;;
		esac

		has_control_char "$url" && { json_select ..; rm -f "$batch_file"; return 1; }
		case "$url" in
		//*) json_select ..; rm -f "$batch_file"; return 1 ;;
		http://*|https://*|/*) ;;
		*) json_select ..; rm -f "$batch_file"; return 1 ;;
		esac
		[ "${#url}" -le 200 ] || { json_select ..; rm -f "$batch_file"; return 1; }

		if [ -n "$icon" ]; then
			[ "${#icon}" -le 64 ] || { json_select ..; rm -f "$batch_file"; return 1; }
			has_control_char "$icon" && { json_select ..; rm -f "$batch_file"; return 1; }
			printf '%s' "$icon" | grep -Eq '^[A-Za-z0-9._-]+$' \
				|| { json_select ..; rm -f "$batch_file"; return 1; }
		fi

		case "$enabled" in 0|1) ;; *) json_select ..; rm -f "$batch_file"; return 1 ;; esac

		printf 'add aurora toolbar_item\n' >> "$batch_file"
		printf "set aurora.@toolbar_item[-1].title='%s'\n" "$trimmed_title" >> "$batch_file"
		printf "set aurora.@toolbar_item[-1].url='%s'\n" "$url" >> "$batch_file"
		[ -n "$icon" ] && printf "set aurora.@toolbar_item[-1].icon='%s'\n" "$icon" >> "$batch_file"
		printf "set aurora.@toolbar_item[-1].enabled='%s'\n" "$enabled" >> "$batch_file"

		json_select ..
		i=$((i + 1))
	done
	json_select ..
	json_cleanup

	# Every field validated: build the delete-then-apply batch. Deletes come
	# first (colors and toolbar_item sections) so nothing from a previous
	# config survives, then the validated data is written; values are
	# single-quoted (critical -- a bare `#` hex is otherwise parsed by `uci
	# batch` as a comment and truncates the value, see apply_theme_preset).
	# The pipeline's exit status (== `uci batch`'s own exit status, since it is
	# the last command in the pipe) MUST be checked here: previously it was
	# discarded and only the later `uci commit` was checked, so a mid-batch
	# failure (e.g. a malformed line) could still be committed with whatever
	# partial state `uci batch` had staged before it failed.
	if ! {
		uci -q show aurora.theme \
			| sed -n 's/^aurora\.theme\.\(\(light\|dark\)_[^=]*\)=.*/delete aurora.theme.\1/p'
		toolbar_section_count=$(uci -q show aurora 2>/dev/null | grep -c '=toolbar_item$')
		i=0
		while [ "$i" -lt "$toolbar_section_count" ]; do
			printf 'delete aurora.@toolbar_item[0]\n'
			i=$((i + 1))
		done
		cat "$batch_file"
		printf "set aurora.theme.hub_applied='%s'\n" "$hub_name"
		printf "set aurora.theme.icon_cache_version='%s'\n" "$(date +%s)"
	} | uci batch; then
		rm -f "$batch_file"
		uci -q revert aurora
		return 1
	fi

	rm -f "$batch_file"

	if ! uci -q commit aurora; then
		uci -q revert aurora
		return 1
	fi

	chmod 644 "$CONFIG_FILE" 2>/dev/null
	return 0
}

# Async apply worker (forked by the hub_apply handler): ①ensure_device_identity
# ②snapshot the current config (single slot, most recent apply only)
# ③fetch the hub payload ④validate+apply locally (no server trust)
# ⑤fetch+verify assets, best-effort ⑥resync derived font CSS ⑦fire-and-forget
# download-count ping. Every step updates the job status file so the
# frontend can poll get_hub_status.
hub_apply_worker() {
	local job_id="$1" id="$2"
	local body tmpfile fetch_rc
	local asset_i=1 a_kind a_sha256 a_url target

	ensure_device_identity

	write_hub_job_status "$job_id" "running" "backup" ""
	mkdir -p "$DEVICE_DIR"
	cp "$CONFIG_FILE" "$DEVICE_DIR/pre-hub-backup.conf" 2>/dev/null
	chmod 644 "$DEVICE_DIR/pre-hub-backup.conf" 2>/dev/null
	# Single-slot snapshot (most recent apply only): drop any images backed
	# up by an earlier apply before this one starts backing up its own.
	rm -rf "$DEVICE_DIR/pre-hub-images"

	write_hub_job_status "$job_id" "running" "fetch" ""
	body=$(hub_http_get "/api/v1/themes/aurora/configs/$id")
	fetch_rc=$?
	if [ "$fetch_rc" != 0 ]; then
		# 2 is the store answering "no such config": the theme was taken down
		# between its card being drawn and Apply being tapped. Telling the
		# user to check their connection over that sends them hunting for a
		# fault that is not theirs.
		if [ "$fetch_rc" = 2 ]; then
			write_hub_job_status "$job_id" "error" "fetch" "invalid_id"
		else
			write_hub_job_status "$job_id" "error" "fetch" "hub_unreachable"
		fi
		return 1
	fi

	# $body is the hub's response to a direct hub_http_get call: a FLAT
	# object (id/name/author/.../payload/assets at the root), never wrapped
	# in "data" -- that envelope is the frontend's, added by hubFetch in
	# utils/hub-api.js on the browser-direct read path, which this code
	# never goes through. validate_and_apply_hub_payload takes this flat
	# body directly and does its own json_load/json_select.
	write_hub_job_status "$job_id" "running" "validate" ""
	if ! validate_and_apply_hub_payload "$body"; then
		write_hub_job_status "$job_id" "error" "validate" "bad_payload"
		return 1
	fi

	write_hub_job_status "$job_id" "running" "assets" ""
	json_load "$body" 2>/dev/null
	if json_select assets 2>/dev/null; then
		mkdir -p "$ICON_PATH"
		asset_i=1
		while json_select "$asset_i" 2>/dev/null; do
			json_get_var a_kind "kind"
			json_get_var a_sha256 "sha256"
			json_get_var a_url "url"
			json_select ..

			# sha256 feeds hub_asset_target_name's login_bg filename (as the
			# first 12 chars); an unvalidated value there could smuggle a
			# path-traversal segment into $ICON_PATH/$target, so it must be
			# rejected outright on any control character -- `grep '^...$'`
			# anchors per line, not to the whole string, so "64 hex chars,
			# newline, garbage" would otherwise still satisfy the regex on
			# its first line (the same bypass class has_control_char guards
			# against everywhere else in this file) -- before being matched
			# against the strict 64-hex-char shape and used for a filename
			# or handed to fetch_verified.
			if ! has_control_char "$a_sha256" \
				&& printf '%s' "$a_sha256" | grep -Eq '^[0-9a-fA-F]{64}$' \
				&& [ -n "$a_url" ]; then
				target=$(hub_asset_target_name "$a_kind" "$a_sha256" "$a_url") && {
					apply_hub_asset "$ICON_PATH/$target" "$a_sha256" "$HUB_BASE$a_url" "$a_kind"
				}
			fi
			asset_i=$((asset_i + 1))
		done
		json_select ..
	fi
	json_cleanup

	write_hub_job_status "$job_id" "running" "finalize" ""
	sync_font_css_from_uci
	update_icon_cache_timestamp
	write_hub_job_status "$job_id" "done" "finalize" ""

	tmpfile=$(mktemp)
	printf '{ "device_hash": "%s" }' "$DEVICE_HASH" > "$tmpfile"
	hub_http_post "/api/v1/themes/aurora/configs/$id/download" "$tmpfile" >/dev/null 2>&1
	rm -f "$tmpfile"

	return 0
}

write_font_job_status() {
	local job_id="$1" state="$2" sans_status="$3" mono_status="$4" sans_error="$5" mono_error="$6"
	local status_file="$FONT_JOB_PATH/$job_id.status"

	mkdir -p "$FONT_JOB_PATH"
	{
		printf "state='%s'\n" "$state"
		printf "sans_status='%s'\n" "$sans_status"
		printf "mono_status='%s'\n" "$mono_status"
		printf "sans_error='%s'\n" "$sans_error"
		printf "mono_error='%s'\n" "$mono_error"
	} > "$status_file.tmp"
	mv "$status_file.tmp" "$status_file"
}

write_default_font_face() {
	cat <<'EOF'
@font-face {
  font-display: swap;
  font-family: "Lato";
  font-style: normal;
  font-weight: 400;
  src: url("/luci-static/aurora/fonts/lato-v24-latin-regular.woff2") format("woff2");
}
EOF
}

get_font_preset_by_stack() {
	local slot="$1" stack="$2" font_name meta meta_stack

	[ -z "$stack" ] && {
		echo "default"
		return 0
	}

	for font_name in $(list_font_names "$slot"); do
		meta=$(get_font_meta "$slot" "$font_name") || continue
		meta_stack=$(echo "$meta" | cut -d'|' -f4)
		if [ "$stack" = "$meta_stack" ]; then
			echo "$font_name"
			return 0
		fi
	done

	return 1
}

get_font_preset_from_uci() {
	local slot="$1" stack

	stack=$(uci -q get "aurora.theme.struct_font_$slot")
	if [ -n "$stack" ] && get_font_preset_by_stack "$slot" "$stack"; then
		return 0
	fi

	echo "default"
}

write_combined_font_css() {
	local sans_preset="${1:-default}" mono_preset="${2:-default}" sans_stack="$3"
	local tmp_file="$FONT_CSS_FILE.tmp"
	local slot preset preset_file face_file f

	get_font_meta "sans" "$sans_preset" >/dev/null 2>&1 || return 1
	get_font_meta "mono" "$mono_preset" >/dev/null 2>&1 || return 1

	mkdir -p "$FONT_PATH"
	{
		write_default_font_face

		for slot in sans mono; do
			case "$slot" in
			sans) preset="$sans_preset" ;;
			mono) preset="$mono_preset" ;;
			esac

			[ "${preset:-default}" = "default" ] && continue

			preset_file="$FONT_PATH/aurora-font-${slot}.preset"
			face_file="$FONT_PATH/aurora-font-${slot}.face"
			if [ -s "$face_file" ] && [ "$(cat "$preset_file" 2>/dev/null)" = "$preset" ]; then
				printf '\n'
				cat "$face_file"
				printf '\n'
			fi
		done

		# Custom uploaded fonts are always declared; browsers only fetch a
		# face when its family is actually referenced by the active stack.
		for f in "$FONT_CUSTOM_PATH"/*.face; do
			[ -s "$f" ] || continue
			printf '\n'
			cat "$f"
			printf '\n'
		done
	} > "$tmp_file" || return 1

	chmod 644 "$tmp_file"
	mv "$tmp_file" "$FONT_CSS_FILE"
	write_font_preload "$sans_preset" "$sans_stack"
	return 0
}

# Single-line marker consumed by the theme's header.ut: the woff2 to
# <link rel="preload">. Points at the active sans 400 weight, whether that
# weight comes from a cached preset or a user-uploaded custom font; falls
# back to the built-in Lato face when no cached webfont is active.
write_font_preload() {
	local sans_preset="${1:-default}" sans_stack_override="$2"
	local target="" candidate
	local sans_family
	local uci_stack meta_file base cfamily cstack face_url
	sans_family=$(get_font_meta "sans" "$sans_preset" 2>/dev/null | cut -d'|' -f3)

	# Reject unsafe overrides (only ever compared for equality against .meta
	# stacks, but keep the same injection posture as other RPC inputs): a
	# newline or shell/markup metacharacter means "not a real stack", so fall
	# back to the current UCI value instead of trusting it.
	case "$sans_stack_override" in
	*[\;\{\}\<\>]*) sans_stack_override="" ;;
	esac
	if printf '%s' "$sans_stack_override" | LC_ALL=C grep -q '[[:cntrl:]]'; then
		sans_stack_override=""
	fi

	if [ "$sans_preset" != "default" ]; then
		candidate="$FONT_PATH/aurora-font-sans-${sans_preset}-400.woff2"
		[ -f "$candidate" ] && [ -s "$FONT_PATH/aurora-font-sans.face" ] && \
			target="/luci-static/aurora/fonts/aurora-font-sans-${sans_preset}-400.woff2"
	fi

	if [ -z "$target" ]; then
		# Custom sans fonts don't resolve to a named preset (they always
		# collapse to "default" downstream), so match the active stack
		# against the custom fonts' .meta stacks the same way remove_font
		# detects "in use", then reuse the exact URL baked into its .face
		# (including the cache-busting query) instead of reconstructing it.
		uci_stack="${sans_stack_override:-$(uci -q get aurora.theme.struct_font_sans)}"
		if [ -n "$uci_stack" ]; then
			for meta_file in "$FONT_CUSTOM_PATH"/sans-*.meta; do
				[ -f "$meta_file" ] || continue
				IFS='|' read -r cfamily cstack < "$meta_file"
				[ "$cstack" = "$uci_stack" ] || continue
				base="${meta_file##*/}"; base="${base%.meta}"
				[ -s "$FONT_CUSTOM_PATH/${base}.face" ] || continue
				face_url=$(sed -n 's/.*url("\([^"]*\)").*/\1/p' "$FONT_CUSTOM_PATH/${base}.face" | head -1)
				[ -n "$face_url" ] && target="$face_url"
				break
			done
		fi
	fi

	if [ -z "$target" ] && [ "$sans_preset" != "default" ] && [ -z "$sans_family" ]; then
		# Pure-stack preset (e.g. "system"): nothing to preload.
		printf '%s\n' "" > "$FONT_PATH/preload.txt.tmp"
		chmod 644 "$FONT_PATH/preload.txt.tmp"
		mv "$FONT_PATH/preload.txt.tmp" "$FONT_PATH/preload.txt"
		return 0
	fi

	[ -z "$target" ] && target="/luci-static/aurora/fonts/lato-v24-latin-regular.woff2"

	printf '%s\n' "$target" > "$FONT_PATH/preload.txt.tmp"
	chmod 644 "$FONT_PATH/preload.txt.tmp"
	mv "$FONT_PATH/preload.txt.tmp" "$FONT_PATH/preload.txt"
}

prepare_font_slot() {
	local slot="$1" preset="$2"
	local preset_file="$FONT_PATH/aurora-font-${slot}.preset"
	local current_preset

	if [ "${preset:-default}" = "default" ]; then
		cleanup_custom_fonts "$slot"
		return 0
	fi

	get_font_meta "$slot" "$preset" >/dev/null 2>&1 || return 1

	current_preset=$(cat "$preset_file" 2>/dev/null)
	if [ "$current_preset" != "$preset" ] || [ ! -s "$FONT_PATH/aurora-font-${slot}.face" ]; then
		cleanup_custom_fonts "$slot"
	fi

	mkdir -p "$FONT_PATH"
	printf '%s' "$preset" > "$preset_file"
	chmod 644 "$preset_file"
	return 0
}

# Download one woff2 with checksum verification: primary source first, then
# fallback; a hash mismatch counts as failure and triggers the fallback too.
fetch_verified() {
	local dest="$1" sha256="$2" url1="$3" url2="$4" url actual

	for url in "$url1" "$url2"; do
		[ -n "$url" ] || continue
		if fetch_url "$dest" "$url" 2>/dev/null; then
			actual=$(sha256sum "$dest" | cut -d' ' -f1)
			[ "$actual" = "$sha256" ] && return 0
		fi
		rm -f "$dest"
	done
	return 1
}

cache_font_slot() {
	local slot="$1" preset="$2"
	local preset_file="$FONT_PATH/aurora-font-${slot}.preset"
	local face_file="$FONT_PATH/aurora-font-${slot}.face"
	local face_tmp="$FONT_PATH/aurora-font-${slot}.face.tmp"
	local files meta family weight sha256 url1 url2 local_file ok=1

	[ "${preset:-default}" = "default" ] && return 0
	if [ -s "$face_file" ] && [ "$(cat "$preset_file" 2>/dev/null)" = "$preset" ]; then
		return 0
	fi

	meta=$(get_font_meta "$slot" "$preset") || return 1
	family=$(printf '%s' "$meta" | cut -d'|' -f3)
	files=$(list_font_files "$slot" "$preset")
	# Pure-stack preset (e.g. "system"): no webfont files to download,
	# so there is nothing to cache and the slot is already in effect.
	[ -z "$files" ] && [ -z "$family" ] && return 0
	[ -n "$files" ] || return 1
	[ -n "$family" ] || return 1

	mkdir -p "$FONT_PATH"
	: > "$face_tmp"

	while IFS='|' read -r weight sha256 url1 url2; do
		[ -n "$weight" ] || continue
		local_file="aurora-font-${slot}-${preset}-${weight}.woff2"
		if ! fetch_verified "$FONT_PATH/$local_file.tmp" "$sha256" "$url1" "$url2"; then
			ok=0
			break
		fi
		mv "$FONT_PATH/$local_file.tmp" "$FONT_PATH/$local_file"
		chmod 644 "$FONT_PATH/$local_file"
		cat >> "$face_tmp" <<FACE
@font-face {
  font-display: swap;
  font-family: "$family";
  font-style: normal;
  font-weight: $weight;
  src: url("/luci-static/aurora/fonts/$local_file") format("woff2");
}
FACE
	done <<EOF
$files
EOF

	if [ "$ok" != "1" ] || [ ! -s "$face_tmp" ]; then
		rm -f "$face_tmp"
		rm -f "$FONT_PATH/aurora-font-${slot}-${preset}"-*.woff2
		return 1
	fi

	# Bail out if the user switched presets while we were downloading.
	[ "$(cat "$preset_file" 2>/dev/null)" = "$preset" ] || {
		rm -f "$face_tmp"
		rm -f "$FONT_PATH/aurora-font-${slot}-${preset}"-*.woff2
		return 1
	}

	chmod 644 "$face_tmp"
	mv "$face_tmp" "$face_file"
	return 0
}

font_job_worker() {
	local job_id="$1" sans_preset="$2" mono_preset="$3" sans_stack="$4"
	local sans_status="ready" mono_status="ready" sans_error="" mono_error=""

	write_font_job_status "$job_id" "running" "$sans_status" "$mono_status" "$sans_error" "$mono_error"

	if [ "${sans_preset:-default}" != "default" ]; then
		if cache_font_slot "sans" "$sans_preset"; then
			sans_status="cached"
		else
			sans_status="fallback"
			sans_error="local_cache_failed"
		fi
		write_combined_font_css "$sans_preset" "$mono_preset" "$sans_stack"
		write_font_job_status "$job_id" "running" "$sans_status" "$mono_status" "$sans_error" "$mono_error"
	fi

	if [ "${mono_preset:-default}" != "default" ]; then
		if cache_font_slot "mono" "$mono_preset"; then
			mono_status="cached"
		else
			mono_status="fallback"
			mono_error="local_cache_failed"
		fi
		write_combined_font_css "$sans_preset" "$mono_preset" "$sans_stack"
	fi

	update_icon_cache_timestamp
	write_font_job_status "$job_id" "done" "$sans_status" "$mono_status" "$sans_error" "$mono_error"
}

start_font_job() {
	local sans_preset="$1" mono_preset="$2" sans_stack="$3"
	local job_id

	[ -z "$sans_preset" ] && sans_preset=$(get_font_preset_from_uci "sans")
	[ -z "$mono_preset" ] && mono_preset=$(get_font_preset_from_uci "mono")
	[ -z "$sans_preset" ] && sans_preset="default"
	[ -z "$mono_preset" ] && mono_preset="default"

	if ! prepare_font_slot "sans" "$sans_preset"; then
		json_init
		json_add_int "result" 1
		json_add_string "error" "Invalid sans font preset"
		json_dump; json_cleanup
		return 0
	fi

	if ! prepare_font_slot "mono" "$mono_preset"; then
		json_init
		json_add_int "result" 1
		json_add_string "error" "Invalid mono font preset"
		json_dump; json_cleanup
		return 0
	fi

	if ! write_combined_font_css "$sans_preset" "$mono_preset" "$sans_stack"; then
		json_init
		json_add_int "result" 1
		json_add_string "error" "Failed to write font CSS"
		json_dump; json_cleanup
		return 0
	fi

	update_icon_cache_timestamp
	job_id="$(date +%s)-$$"
	write_font_job_status "$job_id" "queued" "ready" "ready" "" ""
	(font_job_worker "$job_id" "$sans_preset" "$mono_preset" "$sans_stack") </dev/null >/dev/null 2>&1 &

	json_init
	json_add_int "result" 0
	json_add_string "job_id" "$job_id"
	json_dump; json_cleanup
}

sync_font_css_from_uci() {
	local sans_preset mono_preset

	sans_preset=$(get_font_preset_from_uci "sans")
	mono_preset=$(get_font_preset_from_uci "mono")

	prepare_font_slot "sans" "$sans_preset" || return 1
	prepare_font_slot "mono" "$mono_preset" || return 1
	write_combined_font_css "$sans_preset" "$mono_preset"
}

# sync_font_css_from_uci only rewrites the CSS from whatever woff2 files are
# already cached. A preset names a typeface this router may never have
# downloaded -- and every font stack ends in a fallback family, so a missing
# webfont does not fail loudly, it silently renders as Lato and the preset
# looks like it half-applied. Fetch the files too.
#
# The CSS is written synchronously (so the page that reloads right after this
# already points at whatever is cached) and the download runs detached: it
# talks to the network, and the rpc call must not wait on it. Both slots are
# no-ops when the preset resolves to a built-in stack, so a preset that names
# no webfont costs nothing.
sync_and_cache_fonts_from_uci() {
	local sans_preset mono_preset

	sans_preset=$(get_font_preset_from_uci "sans")
	mono_preset=$(get_font_preset_from_uci "mono")

	prepare_font_slot "sans" "$sans_preset" || return 1
	prepare_font_slot "mono" "$mono_preset" || return 1
	write_combined_font_css "$sans_preset" "$mono_preset" || return 1

	(
		cache_font_slot "sans" "$sans_preset"
		cache_font_slot "mono" "$mono_preset"
		write_combined_font_css "$sans_preset" "$mono_preset"
		update_icon_cache_timestamp
	) </dev/null >/dev/null 2>&1 &

	return 0
}

# One-shot repair after a package upgrade (invoked from uci-defaults, not
# exposed over ubus). The font cache under /www is runtime state the package
# never touches, so a v1 install would otherwise keep serving its old
# aurora-font.css — possibly carrying the remote @import fallback that v2
# removed — until the user re-saves. Idempotent: safe to run on every boot.
migrate_font_cache() {
	local slot stack base preset f meta_file cfamily cstack matched changed=""

	mkdir -p "$FONT_PATH"

	# v1 pipeline leftovers: per-slot css and remote @import fallback files.
	rm -f "$FONT_PATH"/aurora-font-sans.remote.* \
	      "$FONT_PATH"/aurora-font-mono.remote.* \
	      "$FONT_PATH/aurora-font-sans.css" \
	      "$FONT_PATH/aurora-font-mono.css" \
	      "$FONT_PATH"/aurora-font-*.tmp 2>/dev/null

	for slot in sans mono; do
		# Cached woff2 sets whose preset no longer exists in the roster.
		for f in "$FONT_PATH/aurora-font-${slot}-"*.woff2; do
			[ -f "$f" ] || continue
			base="${f##*/aurora-font-${slot}-}"
			preset="${base%.woff2}"
			preset="${preset%-*}"
			get_font_meta "$slot" "$preset" >/dev/null 2>&1 || rm -f "$f"
		done

		# Face/preset markers pointing at a removed preset.
		preset=$(cat "$FONT_PATH/aurora-font-${slot}.preset" 2>/dev/null)
		if [ -n "$preset" ] && ! get_font_meta "$slot" "$preset" >/dev/null 2>&1; then
			rm -f "$FONT_PATH/aurora-font-${slot}.preset" \
			      "$FONT_PATH/aurora-font-${slot}.face"
		fi

		# A stored stack that resolves to neither a v2 preset nor an
		# uploaded custom font would silently degrade to Lato while the
		# settings UI keeps showing a font that no longer exists; reset
		# it so UCI, UI and rendering agree on the default.
		stack=$(uci -q get "aurora.theme.struct_font_${slot}")
		[ -n "$stack" ] || continue
		get_font_preset_by_stack "$slot" "$stack" >/dev/null 2>&1 && continue
		matched=""
		for meta_file in "$FONT_CUSTOM_PATH/${slot}-"*.meta; do
			[ -f "$meta_file" ] || continue
			IFS='|' read -r cfamily cstack < "$meta_file"
			[ "$cstack" = "$stack" ] && { matched=1; break; }
		done
		[ -n "$matched" ] && continue
		uci -q delete "aurora.theme.struct_font_${slot}"
		changed=1
		logger -t aurora "font migration: struct_font_${slot} pointed at a removed preset, reset to default"
	done
	[ -n "$changed" ] && uci -q commit aurora

	sync_font_css_from_uci
}

json_add_font() {
	local name="$1" label="$2" source="$3" family="$4" stack="$5"

	json_add_object ""
		json_add_string "name" "$name"
		json_add_string "label" "$label"
		json_add_string "source" "$source"
		json_add_string "family" "$family"
		json_add_string "stack" "$stack"
	json_close_object
}

get_font_meta() {
	local slot="$1" name="$2" entry

	while IFS= read -r entry; do
		[ "$(echo "$entry" | cut -d'|' -f2)" = "$name" ] || continue
		echo "$entry" | cut -d'|' -f3-
		return 0
	done <<EOF
$(list_font_entries "$slot")
EOF

	return 1
}

list_font_names() {
	list_font_entries "$1" | cut -d'|' -f2
}

parse_installed_packages() {
	local pkg_manager="$1" status_file installed

	theme_inst=""
	config_inst=""
	config_i18n=""

	case "$pkg_manager" in
	opkg)
		status_file="/usr/lib/opkg/status"
		if [ -r "$status_file" ]; then
			# Single pass over the status file: classify each package block, then
			# capture its first Version line. Emits theme/config/i18n on 3 lines.
			installed=$(awk '
				/^Package: luci-theme-aurora$/ { cap = "t"; next }
				/^Package: luci-app-aurora-config$/ { cap = "c"; next }
				/^Package: luci-i18n-aurora-config-/ { cap = "i"; pkg = $2; next }
				/^Version:/ {
					if (cap == "t") theme = $2
					else if (cap == "c") config = $2
					else if (cap == "i") i18n = i18n (i18n ? "," : "") pkg ":" $2
					cap = ""
				}
				END { print theme; print config; print i18n }
			' "$status_file")
			{ read -r theme_inst; read -r config_inst; read -r config_i18n; } <<-EOF
			$installed
			EOF
		elif command -v opkg >/dev/null 2>&1; then
			installed=$(opkg list-installed 2>/dev/null)
			theme_inst=$(printf '%s\n' "$installed" | grep "^luci-theme-aurora " | awk '{print $3}')
			config_inst=$(printf '%s\n' "$installed" | grep "^luci-app-aurora-config " | awk '{print $3}')
			config_i18n=$(printf '%s\n' "$installed" | grep "^luci-i18n-aurora-config-" | awk '{print $1 ":" $3}' | tr '\n' ',' | sed 's/,$//')
		fi
		;;
	apk)
		# Read the database directly instead of running `apk list -I`, which
		# spawns apk to parse every installed package on each page load -- the
		# most expensive thing this call used to do on a weak router. The
		# format (verified on a snapshot device) is one blank-line-separated
		# record per package, with "P:<name>" followed by "V:<version>".
		installed=$(awk '
			/^P:/ { pkg = substr($0, 3); next }
			/^V:/ {
				if (pkg == "luci-theme-aurora") theme = substr($0, 3)
				else if (pkg == "luci-app-aurora-config") config = substr($0, 3)
				else if (pkg ~ /^luci-i18n-aurora-config-/)
					i18n = i18n (i18n ? "," : "") pkg ":" substr($0, 3)
				pkg = ""
			}
			END { print theme; print config; print i18n }
		' /lib/apk/db/installed 2>/dev/null)
		{ read -r theme_inst; read -r config_inst; read -r config_i18n; } <<-EOF
		$installed
		EOF
		;;
	esac
}

# Remove our own feed lines before appending a fresh one, so re-running is a
# no-op and switching channels leaves no stale entry. Matched by fixed string,
# so other feeds' lines are never touched.
aurora_drop_feed_lines() {
	local file="$1" pattern="$2"
	[ -f "$file" ] || return 0
	grep -vF "$pattern" "$file" > "$file.tmp" 2>/dev/null || true
	mv "$file.tmp" "$file"
}

aurora_feed_error() {
	json_init
	json_add_int "result" 1
	json_add_string "error" "$1"
	json_add_boolean "index_refreshed" "0"
	json_dump; json_cleanup
}

# Steps 2 and 3 of install.sh: import the signing key, add the feed, refresh
# the index. The key ships inside this package rather than being downloaded --
# the trust is already anchored in the installed package, and the router needs
# no outbound access to get it.
aurora_add_feed() {
	local pm refreshed="0"

	detect_package_manager; pm="$_pkg_manager"
	case "$pm" in
	apk)
		mkdir -p /etc/apk/keys /etc/apk/repositories.d 2>/dev/null || {
			aurora_feed_error "cannot create the apk directories"; return
		}
		cp "$AURORA_FEED_KEYS/eamonxg.pem" /etc/apk/keys/eamonxg.pem || {
			aurora_feed_error "cannot install the signing key"; return
		}
		aurora_drop_feed_lines /etc/apk/repositories.d/customfeeds.list \
			"https://$AURORA_FEED_HOST/"
		echo "https://$AURORA_FEED_HOST/$AURORA_FEED_CHANNEL/apk/packages.adb" \
			>> /etc/apk/repositories.d/customfeeds.list
		apk update >/dev/null 2>&1 && refreshed="1"
		;;
	opkg)
		mkdir -p /etc/opkg/keys 2>/dev/null || {
			aurora_feed_error "cannot create /etc/opkg/keys"; return
		}
		cp "$AURORA_FEED_KEYS/eamonxg.pub" "/etc/opkg/keys/$AURORA_FEED_FPR" || {
			aurora_feed_error "cannot install the signing key"; return
		}
		aurora_drop_feed_lines /etc/opkg/customfeeds.conf "src/gz eamonxg "
		echo "src/gz eamonxg https://$AURORA_FEED_HOST/$AURORA_FEED_CHANNEL/opkg" \
			>> /etc/opkg/customfeeds.conf
		opkg update >/dev/null 2>&1 && refreshed="1"
		;;
	*)
		aurora_feed_error "no supported package manager on this device"
		return
		;;
	esac

	# Writing the source and refreshing the index fail independently, and the
	# page tells the user different things about each.
	json_init
	json_add_int "result" 0
	json_add_string "error" ""
	json_add_boolean "index_refreshed" "$refreshed"
	json_dump; json_cleanup
}

json_add_feed_status() {
	local pm configured="0" channel="" line=""

	detect_package_manager; pm="$_pkg_manager"
	case "$pm" in
	apk)
		line=$(grep -F "https://$AURORA_FEED_HOST/" \
			/etc/apk/repositories.d/customfeeds.list 2>/dev/null | head -1)
		;;
	opkg)
		line=$(grep -F "src/gz eamonxg " \
			/etc/opkg/customfeeds.conf 2>/dev/null | head -1)
		;;
	esac

	if [ -n "$line" ]; then
		configured="1"
		case "$line" in
		*/releases/*) channel="releases" ;;
		*/snapshots/*) channel="snapshots" ;;
		esac
	fi

	json_add_object "feed"
		json_add_string "pm" "$pm"
		json_add_boolean "configured" "$configured"
		json_add_string "channel" "$channel"
	json_close_object
}

json_add_installed_versions() {
	local pkg_manager

	detect_package_manager; pkg_manager="$_pkg_manager"
	parse_installed_packages "$pkg_manager"

	json_add_object "theme"; json_add_string "installed_version" "$theme_inst"; json_close_object
	json_add_object "config"
		json_add_string "installed_version" "$config_inst"
		json_add_string "i18n_packages" "$config_i18n"
	json_close_object
}

json_add_font_presets() {
	local slot_name presets
	local meta_file base cslot cname cfamily cstack

	presets=$(cat "$FONT_PRESETS_FILE" 2>/dev/null)

	json_add_object "fonts"
	for slot_name in sans mono; do
		json_add_array "$slot_name"
		while IFS='|' read -r _kind _slot _name _label _source _family _stack; do
			[ "$_kind" = "font" ] || continue
			[ "$_slot" = "$slot_name" ] || continue
			json_add_font "$_name" "$_label" "$_source" "$_family" "$_stack"
		done <<-EOF
		$presets
		EOF
		json_close_array
	done
	json_add_array "custom"
	for meta_file in "$FONT_CUSTOM_PATH"/*.meta; do
		[ -f "$meta_file" ] || continue
		base="${meta_file##*/}"; base="${base%.meta}"
		cslot="${base%%-*}"; cname="${base#*-}"
		IFS='|' read -r cfamily cstack < "$meta_file"
		json_add_object ""
			json_add_string "slot" "$cslot"
			json_add_string "name" "$cname"
			json_add_string "family" "$cfamily"
			json_add_string "stack" "$cstack"
			csize=0
			[ -f "$FONT_CUSTOM_PATH/${base}.woff2" ] && csize=$(wc -c < "$FONT_CUSTOM_PATH/${base}.woff2")
			json_add_int "size" "$csize"
		json_close_object
	done
	json_close_array
	json_close_object
}

json_add_icons() {
	local file size path sizes

	json_add_array "icons"
	for file in "$ICON_PATH"/*; do
		[ -f "$file" ] && json_add_string "" "${file##*/}"
	done
	json_close_array

	# One wc for the whole directory instead of one per file: on the routers
	# this runs on, the fork costs more than the read it performs. Output is
	# "<size> <path>" per file, plus a "total" line when there is more than
	# one -- the -f guard drops that line without matching its wording.
	# Fed through a heredoc rather than a pipe: a pipe runs the loop in a
	# subshell, and every json_add_int would be written to a shell that exits.
	sizes=$(wc -c "$ICON_PATH"/* 2>/dev/null)
	json_add_object "icon_sizes"
	while read -r size path; do
		[ -f "$path" ] && json_add_int "${path##*/}" "$size"
	done <<-EOF
	$sizes
	EOF
	json_close_object
}

json_add_theme_preset_snapshot() {
	local name="$1" template key value

	require_color_token_keys || {
		json_add_int "result" 1
		json_add_string "error" "Missing or empty $COLOR_TOKENS_FILE"
		return
	}

	name=$(normalize_preset_name "$name")
	template=$(resolve_preset_path "$name") || {
		json_add_int "result" 1
		json_add_string "error" "Unknown preset"
		return
	}

	if ! load_preset_snapshot "$template"; then
		json_add_int "result" 1
		json_add_string "error" "Invalid preset content"
		return
	fi

	json_add_int "result" 0
	json_add_string "name" "$name"

	# The snapshot is one flat list, but it is published grouped the way a hub
	# payload groups the same fields (see build_share_payload). An object
	# called "colors" that also held nav_type would be a trap for the next
	# reader -- and the settings UI looks colours up by key, so a stray
	# struct_* in there would sit undetected until something iterated it.
	json_add_object "colors"
	while IFS='=' read -r key value; do
		case "$key" in
		light_*|dark_*) json_add_string "$key" "$value" ;;
		esac
	done <<-EOF
	$PRESET_SNAPSHOT
	EOF
	json_close_object

	json_add_object "layout"
	while IFS='=' read -r key value; do
		case "$key" in
		nav_type|toolbar_enabled|struct_spacing|struct_radius_base|struct_content_width_centered)
			json_add_string "$key" "$value" ;;
		esac
	done <<-EOF
	$PRESET_SNAPSHOT
	EOF
	json_close_object

	json_add_object "typography"
	while IFS='=' read -r key value; do
		case "$key" in
		struct_font_sans|struct_font_mono) json_add_string "$key" "$value" ;;
		esac
	done <<-EOF
	$PRESET_SNAPSHOT
	EOF
	json_close_object
}

case "$1" in
# Maintenance verb for uci-defaults; rpcd itself only ever passes list/call.
"migrate-fonts")
	migrate_font_cache
	exit 0
	;;
"list")
	json_init
	json_add_object "list_icons"; json_close_object
	json_add_object "upload_icon"
		json_add_string "filename" "filename"
	json_close_object
	json_add_object "remove_icon"
		json_add_string "filename" "filename"
	json_close_object
	json_add_object "reset_defaults"; json_close_object
	json_add_object "add_feed"; json_close_object
	json_add_object "get_init_data"; json_close_object
	json_add_object "get_theme_preset"
		json_add_string "name" "name"
	json_close_object
	json_add_object "get_font_presets"; json_close_object
	json_add_object "get_font_status"
		json_add_string "job_id" "job_id"
	json_close_object
	json_add_object "prepare_font"
		json_add_string "sans" "sans"
		json_add_string "mono" "mono"
		json_add_string "sans_stack" "sans_stack"
	json_close_object
	json_add_object "upload_font"
		json_add_string "slot" "slot"
		json_add_string "family" "family"
	json_close_object
	json_add_object "remove_font"
		json_add_string "slot" "slot"
		json_add_string "name" "name"
	json_close_object
	json_add_object "apply_theme_preset"
		json_add_string "name" "name"
	json_close_object
	json_add_object "export_config"; json_close_object
	json_add_object "import_config"; json_close_object
	json_add_object "get_system_info"; json_close_object
	json_add_object "remove_login_bg"; json_close_object
	json_add_object "write_pwa_manifest"; json_close_object
	json_add_object "hub_apply"
		json_add_string "id" "id"
	json_close_object
	json_add_object "get_hub_status"
		json_add_string "job_id" "job_id"
	json_close_object
	json_add_object "hub_restore_backup"; json_close_object
	json_add_object "hub_share"
		json_add_string "name" "name"
		json_add_string "description" "description"
	json_close_object
	json_add_object "hub_set_nickname"
		json_add_string "nickname" "nickname"
	json_close_object
	json_add_object "hub_me"; json_close_object
	json_add_object "hub_export_key"; json_close_object
	json_add_object "hub_import_key"
		json_add_string "key" "key"
	json_close_object
	json_add_object "hub_update"
		json_add_string "id" "id"
		json_add_string "name" "name"
		json_add_string "description" "description"
	json_close_object
	json_add_object "hub_delete"
		json_add_string "id" "id"
	json_close_object
	json_dump; json_cleanup
	;;

"call")
	case "$2" in
	"get_init_data")
		active_preset=$(uci -q get aurora.theme.active_preset)
		active_preset=$(normalize_preset_name "$active_preset")

		json_init
		json_add_string "active_preset" "$active_preset"
		json_add_object "versions"
			json_add_installed_versions
		json_close_object
		# Rides along here on purpose: the settings page must not gain a round
		# trip just to learn whether this router has the feed configured.
		json_add_feed_status
		json_add_font_presets
		json_add_icons
		json_add_object "theme_preset"
			json_add_theme_preset_snapshot "$active_preset"
		json_close_object
		json_dump; json_cleanup
		;;

	"add_feed")
		aurora_add_feed
		;;

	"reset_defaults")
		if [ -f "$DEFAULT_TEMPLATE" ]; then
			cp "$DEFAULT_TEMPLATE" "$CONFIG_FILE"
			chmod 644 "$CONFIG_FILE"
			cleanup_custom_fonts
			# Uploaded custom fonts survive a settings reset, matching the
			# promise the confirm dialog makes for uploaded images; only
			# the selection is cleared. remove_font deletes the files.
			sync_font_css_from_uci
			update_icon_cache_timestamp
			echo '{ "result": 0 }'
		else
			echo '{ "result": 1, "error": "Template file not found" }'
		fi
		;;

	"get_theme_preset")
		read -r input; json_load "$input" 2>/dev/null
		json_get_var name "name"
		json_cleanup

		json_init
		json_add_theme_preset_snapshot "$name"
		json_dump; json_cleanup
		;;

	"get_font_presets")
		json_init
		json_add_font_presets
		json_dump; json_cleanup
		;;

	"get_font_status")
		read -r input; json_load "$input" 2>/dev/null
		json_get_var job_id "job_id"
		json_cleanup

		case "$job_id" in
		""|*[!A-Za-z0-9_.-]*)
			json_init
			json_add_string "state" "missing"
			json_add_string "error" "job_not_found"
			json_dump; json_cleanup
			exit 0
			;;
		esac

		status_file="$FONT_JOB_PATH/$job_id.status"
		if [ -n "$job_id" ] && [ -f "$status_file" ]; then
			. "$status_file"
			json_init
			json_add_string "state" "${state:-unknown}"
			json_add_string "sans_status" "${sans_status:-unknown}"
			json_add_string "mono_status" "${mono_status:-unknown}"
			json_add_string "sans_error" "${sans_error:-}"
			json_add_string "mono_error" "${mono_error:-}"
			json_dump; json_cleanup
		else
			json_init
			json_add_string "state" "missing"
			json_add_string "error" "job_not_found"
			json_dump; json_cleanup
		fi
		;;

	"prepare_font")
		read -r input; json_load "$input" 2>/dev/null
		json_get_var sans_preset "sans"
		json_get_var mono_preset "mono"
		json_get_var sans_stack "sans_stack"
		json_cleanup

		start_font_job "$sans_preset" "$mono_preset" "$sans_stack"
		;;

	"upload_font")
		read -r input; json_load "$input" 2>/dev/null
		json_get_var slot "slot"
		json_get_var family "family"
		json_cleanup

		case "$slot" in sans|mono) ;; *)
			rm -f "$FONT_TMP_UPLOAD"
			echo '{ "result": 1, "error": "Invalid slot" }'; exit 0 ;;
		esac
		case "$family" in
		""|*[!A-Za-z0-9\ \'-]*)
			rm -f "$FONT_TMP_UPLOAD"
			echo '{ "result": 1, "error": "Invalid family name" }'; exit 0 ;;
		esac
		[ ${#family} -le 64 ] || {
			rm -f "$FONT_TMP_UPLOAD"
			echo '{ "result": 1, "error": "Family name too long" }'; exit 0; }
		receive_upload "$FONT_TMP_UPLOAD" font || exit 0

		slug=$(printf '%s' "$family" | tr 'A-Z' 'a-z' | sed 's/[^a-z0-9]\{1,\}/-/g;s/^-//;s/-$//')
		[ -n "$slug" ] || {
			rm -f "$FONT_TMP_UPLOAD"
			echo '{ "result": 1, "error": "Invalid family name" }'; exit 0; }

		meta_path="$FONT_CUSTOM_PATH/${slot}-${slug}.meta"
		if [ -f "$meta_path" ]; then
			existing_family=$(cut -d'|' -f1 "$meta_path")
			[ "$existing_family" = "$family" ] || {
				rm -f "$FONT_TMP_UPLOAD"
				echo '{ "result": 1, "error": "A custom font with a conflicting name already exists" }'; exit 0; }
		fi

		# Compose the stack from the roster's default entry so the tail
		# has a single source of truth (the generated font-presets.conf).
		# write_font_preload/remove_font match stacks by string equality,
		# so a drifting duplicate here would silently break them.
		default_stack=$(get_font_meta "$slot" "default" | cut -d'|' -f4)
		[ -n "$default_stack" ] || {
			rm -f "$FONT_TMP_UPLOAD"
			echo '{ "result": 1, "error": "Font preset roster unavailable" }'; exit 0; }
		stack="\"$family\", $default_stack"

		mkdir -p "$FONT_CUSTOM_PATH"
		if ! mv "$FONT_TMP_UPLOAD" "$FONT_CUSTOM_PATH/${slot}-${slug}.woff2" 2>"/dev/null"; then
			rm -f "$FONT_TMP_UPLOAD"
			echo '{ "result": 1, "error": "Failed to store file" }'; exit 0
		fi
		chmod 644 "$FONT_CUSTOM_PATH/${slot}-${slug}.woff2"
		printf '%s|%s\n' "$family" "$stack" > "$FONT_CUSTOM_PATH/${slot}-${slug}.meta"
		chmod 644 "$FONT_CUSTOM_PATH/${slot}-${slug}.meta"
		cat > "$FONT_CUSTOM_PATH/${slot}-${slug}.face" <<FACE
@font-face {
  font-display: swap;
  font-family: "$family";
  font-style: normal;
  font-weight: 400;
  src: url("/luci-static/aurora/fonts/custom/${slot}-${slug}.woff2?v=$(date +%s)") format("woff2");
}
FACE
		chmod 644 "$FONT_CUSTOM_PATH/${slot}-${slug}.face"

		sync_font_css_from_uci
		update_icon_cache_timestamp

		json_init
		json_add_int "result" 0
		json_add_string "name" "$slug"
		json_add_string "stack" "$stack"
		json_dump; json_cleanup
		;;

	"remove_font")
		read -r input; json_load "$input" 2>/dev/null
		json_get_var slot "slot"
		json_get_var name "name"
		json_cleanup

		case "$slot" in sans|mono) ;; *)
			echo '{ "result": 1, "error": "Invalid slot" }'; exit 0 ;;
		esac
		case "$name" in
		""|*[!a-z0-9-]*)
			echo '{ "result": 1, "error": "Invalid font name" }'; exit 0 ;;
		esac

		meta_file="$FONT_CUSTOM_PATH/${slot}-${name}.meta"
		if [ -f "$meta_file" ]; then
			IFS='|' read -r _cfamily cstack < "$meta_file"
			current=$(uci -q get "aurora.theme.struct_font_$slot")
			if [ -n "$current" ] && [ "$current" = "$cstack" ]; then
				uci -q delete "aurora.theme.struct_font_$slot"
				uci -q commit aurora
			fi
		fi
		rm -f "$FONT_CUSTOM_PATH/${slot}-${name}.woff2" \
		      "$FONT_CUSTOM_PATH/${slot}-${name}.meta" \
		      "$FONT_CUSTOM_PATH/${slot}-${name}.face"

		sync_font_css_from_uci
		update_icon_cache_timestamp
		echo '{ "result": 0 }'
		;;

	"apply_theme_preset")
		read -r input; json_load "$input"; json_get_var name "name"; json_cleanup
		name=$(normalize_preset_name "$name")

		require_color_token_keys || {
			echo '{ "result": 1, "error": "Missing or empty /usr/share/aurora/color-tokens.conf" }'
			exit 0
		}

		template=$(resolve_preset_path "$name") || {
			echo '{ "result": 1, "error": "Unknown preset" }'
			exit 0
		}

		if ! load_preset_snapshot "$template"; then
			echo '{ "result": 1, "error": "Invalid preset content" }'
			exit 0
		fi

		# Stage the whole preset in one `uci batch`: drop the existing color
		# options, write the snapshot, then update the preset bookkeeping --
		# replacing what used to be ~180 individual uci invocations.
		#
		# The snapshot carries the preset's layout and typography too, so the
		# same loop writes nav_type, spacing, radius, content width and both
		# font stacks. Those are `set` over whatever is there, never deleted
		# first: unlike the colour keys they are a fixed, always-present set,
		# and every one of them is in the snapshot.
		#
		# toolbar_item sections are deliberately left alone. They hold
		# shortcuts the user wrote, and this path -- unlike hub_apply_worker --
		# takes no pre-apply backup, so replacing them would destroy data with
		# no way back. A preset only carries the toolbar_enabled switch.
		#
		# Values MUST be single-quoted: `uci batch` parses each line as a
		# shell-like command and treats a bare `#` as a comment, so an
		# unquoted hex color (e.g. set ...=#fcfcfc) is silently truncated to
		# an empty value. Snapshot values are already validated injection-safe
		# (no ;{}<> or control chars) and contain no single quotes.
		{
			uci -q show aurora.theme \
				| sed -n 's/^aurora\.theme\.\(\(light\|dark\)_[^=]*\)=.*/delete aurora.theme.\1/p'
			while IFS='=' read -r key value; do
				[ -n "$key" ] && printf "set aurora.theme.%s='%s'\n" "$key" "$value"
			done <<-EOF
			$PRESET_SNAPSHOT
			EOF
			printf "set aurora.theme.active_preset='%s'\n" "$name"
			printf "set aurora.theme.icon_cache_version='%s'\n" "$(date +%s)"
		} | uci batch

		if ! uci -q commit aurora; then
			uci -q revert aurora
			echo '{ "result": 1, "error": "Failed to apply preset" }'
			exit 0
		fi

		chmod 644 "$CONFIG_FILE" 2>/dev/null
		# The preset just chose a typeface. Rewrite the font CSS now and fetch
		# whatever woff2 files it names in the background, or the page that
		# reloads in a moment renders the fallback family instead.
		sync_and_cache_fonts_from_uci
		echo '{ "result": 0 }'
		;;

	"export_config")
		if [ -f "$CONFIG_FILE" ]; then
			if cp "$CONFIG_FILE" "$EXPORT_CONFIG_TMP" 2>/dev/null; then
				chmod 0644 "$EXPORT_CONFIG_TMP"
				json_init
				json_add_int "result" 0
				json_add_string "filename" "aurora"
				json_add_string "path" "$EXPORT_CONFIG_TMP"
				json_dump; json_cleanup
			else
				echo '{ "result": 1, "error": "Failed to prepare export file" }'
			fi
		else
			echo '{ "result": 1, "error": "Config file not found" }'
		fi
		;;

	"import_config")
		if ! require_color_token_keys; then
			echo '{ "result": 1, "error": "Missing or empty /usr/share/aurora/color-tokens.conf" }'
		elif [ ! -f "$IMPORT_CONFIG_TMP" ]; then
			echo '{ "result": 1, "error": "Upload file not found" }'
		else
			if grep -Eq "^config[[:space:]]+aurora" "$IMPORT_CONFIG_TMP" 2>/dev/null \
				&& validate_import_color_options; then
				cp "$IMPORT_CONFIG_TMP" "$CONFIG_FILE"
				chmod 644 "$CONFIG_FILE"
				sync_font_css_from_uci
				update_icon_cache_timestamp
				rm -f "$IMPORT_CONFIG_TMP"
				echo '{ "result": 0 }'
			else
				rm -f "$IMPORT_CONFIG_TMP"
				echo '{ "result": 1, "error": "Invalid config file" }'
			fi
		fi
		;;

	"list_icons")
		json_init
		json_add_icons
		json_dump; json_cleanup
		;;

	"upload_icon")
		read -r input; json_load "$input"; json_get_var filename "filename"; json_cleanup
		receive_upload "$TMP_UPLOAD_PATH" image "$filename" || exit 0

		mkdir -p "$ICON_PATH"
		if mv "$TMP_UPLOAD_PATH" "$ICON_PATH/$filename" 2>"/dev/null"; then
			chmod 0644 "$ICON_PATH/$filename"
			update_icon_cache_timestamp
			echo '{ "result": 0 }'
		else
			rm -f "$TMP_UPLOAD_PATH"
			echo '{ "result": 1, "error": "Failed to store file" }'
		fi
		;;

	"remove_icon")
		read -r input; json_load "$input"; json_get_var filename "filename"; json_cleanup
		if dirname "$filename" | grep -q "\.\."; then echo '{ "result": 255 }'; exit 255; fi
		rm -f "$ICON_PATH/$filename"

		# Every slot that named the deleted file has to be cleared, not just
		# the login background: an icon can be assigned as the logo, a favicon,
		# a PWA icon, the iOS home-screen icon and a toolbar shortcut at the
		# same time. Leaving those set pointed uci at a file that no longer
		# exists -- the theme then served a missing logo, iOS kept a 404
		# home-screen icon, and build_share_payload's `[ -f "$file" ]` check
		# dropped the asset while the share manifest still promised it. Same
		# slots the asset loop in build_share_payload walks, plus
		# pwa_apple_touch (settable in theme.js, defaulted in
		# root/usr/share/aurora/default.template) and struct_login_bg.
		icon_slot_cleared=0
		for icon_slot in logo_svg favicon_png favicon_ico pwa_icon_192 pwa_icon_512 pwa_apple_touch; do
			icon_slot_file=$(uci -q get "aurora.theme.$icon_slot")
			[ -n "$icon_slot_file" ] && [ "$icon_slot_file" = "$filename" ] || continue
			uci -q delete "aurora.theme.$icon_slot"
			icon_slot_cleared=1
		done

		# Toolbar shortcuts pick their image from the same uploaded icons, and
		# a dangling name here travels further than the others:
		# build_share_payload ships `icon` as a plain string with no existence
		# check, so the broken shortcut image gets published to the hub and
		# every downstream applier inherits it. toolbar_item sections are
		# anonymous, so their uci ids are recovered from `uci show` exactly
		# the way build_share_payload does it, never by index.
		for toolbar_sid in $(uci show aurora 2>/dev/null | sed -n 's/^aurora\.\([^.=]*\)=toolbar_item$/\1/p'); do
			icon_slot_file=$(uci -q get "aurora.$toolbar_sid.icon")
			[ -n "$icon_slot_file" ] && [ "$icon_slot_file" = "$filename" ] || continue
			uci -q delete "aurora.$toolbar_sid.icon"
			icon_slot_cleared=1
		done

		current_login_bg=$(uci -q get aurora.theme.struct_login_bg)
		current_file=$(printf '%s' "$current_login_bg" | sed "s|url('/luci-static/aurora/images/||;s|')||")
		if [ -n "$current_file" ] && [ "$current_file" = "$filename" ]; then
			uci -q delete aurora.theme.struct_login_bg
			uci -q delete aurora.theme.struct_login_bg_lqip
			icon_slot_cleared=1
		fi

		# One commit for the whole removal, and only when a slot actually
		# changed -- committing unconditionally would flush unrelated pending
		# aurora changes made by another handler.
		[ "$icon_slot_cleared" = 1 ] && uci -q commit aurora
		update_icon_cache_timestamp
		echo '{ "result": 0 }'
		;;

	"write_pwa_manifest")
		icon_192=$(uci -q get aurora.theme.pwa_icon_192)
		icon_512=$(uci -q get aurora.theme.pwa_icon_512)
		[ -z "$icon_192" ] && icon_192="app-icon-192x192.png"
		[ -z "$icon_512" ] && icon_512="app-icon-512x512.png"

		manifest_file="$ICON_PATH/app.webmanifest"
		tmp_file="${manifest_file}.tmp"

		cat > "$tmp_file" <<MANIFEST
{
  "name": "LuCI Aurora",
  "short_name": "Aurora",
  "start_url": "/cgi-bin/luci",
  "scope": "/",
  "display": "standalone",
  "background_color": "#f8fafc",
  "theme_color": "#f8fafc",
  "icons": [
    {
      "src": "/luci-static/aurora/images/${icon_192}",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any maskable"
    },
    {
      "src": "/luci-static/aurora/images/${icon_512}",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any maskable"
    }
  ]
}
MANIFEST

		if mv "$tmp_file" "$manifest_file" 2>/dev/null; then
			chmod 0644 "$manifest_file"
			echo '{ "result": 0 }'
		else
			rm -f "$tmp_file"
			echo '{ "result": 1, "error": "Failed to write manifest" }'
		fi
		;;

	"get_system_info")
		json_init
		detect_package_manager
		json_add_string "package_manager" "$_pkg_manager"
		json_add_string "language" "$(get_system_lang)"
		json_dump; json_cleanup
		;;

	"hub_apply")
		read -r input; json_load "$input" 2>/dev/null
		json_get_var id "id"; json_cleanup
		case "$id" in ''|*[!A-Za-z0-9]*)
			echo '{ "result": 1, "error": "invalid_id" }'; exit 0 ;;
		esac

		ensure_device_identity

		job_id="$(date +%s)-$$"
		write_hub_job_status "$job_id" "queued" "start" ""
		(hub_apply_worker "$job_id" "$id") </dev/null >/dev/null 2>&1 &

		json_init
		json_add_int "result" 0
		json_add_string "job_id" "$job_id"
		json_dump; json_cleanup
		;;

	"get_hub_status")
		read -r input; json_load "$input" 2>/dev/null
		json_get_var job_id "job_id"
		json_cleanup

		case "$job_id" in
		""|*[!A-Za-z0-9_.-]*)
			json_init
			json_add_string "state" "missing"
			json_add_string "error" "job_not_found"
			json_dump; json_cleanup
			exit 0
			;;
		esac

		status_file="$HUB_JOB_PATH/$job_id.status"
		if [ -n "$job_id" ] && [ -f "$status_file" ]; then
			. "$status_file"
			json_init
			json_add_string "state" "${state:-unknown}"
			json_add_string "step" "${step:-}"
			json_add_string "error" "${error:-}"
			json_dump; json_cleanup
		else
			json_init
			json_add_string "state" "missing"
			json_add_string "error" "job_not_found"
			json_dump; json_cleanup
		fi
		;;

	"hub_restore_backup")
		if [ -f "$DEVICE_DIR/pre-hub-backup.conf" ]; then
			cp "$DEVICE_DIR/pre-hub-backup.conf" "$CONFIG_FILE"
			chmod 644 "$CONFIG_FILE"
			restore_pre_hub_images
			sync_font_css_from_uci
			update_icon_cache_timestamp
			echo '{ "result": 0 }'
		else
			echo '{ "result": 1, "error": "no_backup" }'
		fi
		;;

	"hub_share")
		read -r input; json_load "$input" 2>/dev/null
		json_get_var name "name"
		json_get_var description "description"
		json_cleanup

		has_control_char "$name" && {
			echo '{ "result": 1, "error": "invalid_name" }'; exit 0; }
		name_len=${#name}
		[ "$name_len" -ge 1 ] && [ "$name_len" -le 60 ] || {
			echo '{ "result": 1, "error": "invalid_name" }'; exit 0; }

		has_control_char "$description" && {
			echo '{ "result": 1, "error": "invalid_description" }'; exit 0; }
		[ "${#description}" -le 500 ] || {
			echo '{ "result": 1, "error": "invalid_description" }'; exit 0; }

		require_color_token_keys || {
			echo '{ "result": 1, "error": "config_unavailable" }'; exit 0; }

		ensure_device_identity

		share_payload_tmp=$(mktemp)
		if ! build_share_payload "$share_payload_tmp"; then
			rm -f "$share_payload_tmp" "$share_payload_tmp.b64"
			echo '{ "result": 1, "error": "payload_build_failed" }'
			exit 0
		fi
		share_payload_json=$(cat "$share_payload_tmp")
		share_assets_json="[$(tr '\n' ',' < "$share_payload_tmp.b64" 2>/dev/null | sed 's/,$//')]"
		rm -f "$share_payload_tmp" "$share_payload_tmp.b64"

		name_esc=$(json_escape_string "$name")
		description_esc=$(json_escape_string "$description")

		# No author field: the hub signs this with the creator profile that
		# owns the device_token.
		share_body_tmp=$(mktemp)
		printf '{"device_token":"%s","name":"%s","description":"%s","payload":%s,"assets":%s}' \
			"$DEVICE_TOKEN" "$name_esc" "$description_esc" \
			"$share_payload_json" "$share_assets_json" \
			> "$share_body_tmp"

		if share_body=$(hub_http_post "/api/v1/themes/aurora/configs" "$share_body_tmp"); then
			json_load "$share_body" 2>/dev/null
			json_get_var share_id "id"
			json_cleanup
			if [ -n "$share_id" ]; then
				# Nothing recorded locally: hub_me lists what this key owns
				# straight from the hub, so a local copy could only ever go
				# stale or lie after a key import.
				json_init
				json_add_int "result" 0
				json_add_string "id" "$share_id"
				json_dump; json_cleanup
			else
				echo '{ "result": 1, "error": "hub_bad_response" }'
			fi
		else
			echo '{ "result": 1, "error": "hub_unreachable" }'
		fi
		rm -f "$share_body_tmp"
		;;

	"hub_me")
		# The creator profile plus everything this key has published. The hub
		# is the authority here -- no local id list is consulted, which is
		# what makes a reflash survivable: restore device.key and the listing
		# comes back on its own.
		#
		# This also replaces a per-id serial fetch (one hub round trip per
		# published config, on every store page load) with a single request.
		ensure_device_identity

		me_body_tmp=$(mktemp)
		printf '{"device_token":"%s"}' "$DEVICE_TOKEN" > "$me_body_tmp"

		if me_body=$(hub_http_post "/api/v1/me" "$me_body_tmp"); then
			printf '{ "result": 0, "data": %s }\n' "$me_body"
		else
			echo '{ "result": 1, "error": "hub_unreachable" }'
		fi
		rm -f "$me_body_tmp"
		;;

	"hub_set_nickname")
		read -r input; json_load "$input" 2>/dev/null
		json_get_var nickname "nickname"
		json_cleanup

		has_control_char "$nickname" && {
			echo '{ "result": 1, "error": "invalid_nickname" }'; exit 0; }
		nickname_len=${#nickname}
		[ "$nickname_len" -ge 1 ] && [ "$nickname_len" -le 40 ] || {
			echo '{ "result": 1, "error": "invalid_nickname" }'; exit 0; }

		ensure_device_identity

		nickname_esc=$(json_escape_string "$nickname")
		nick_body_tmp=$(mktemp)
		printf '{"device_token":"%s","nickname":"%s"}' "$DEVICE_TOKEN" "$nickname_esc" \
			> "$nick_body_tmp"

		# The hub answers 200 even for "that name is taken": wget collapses
		# every 4xx into the same failure as an unreachable host, so a 409
		# would reach the page as "couldn't reach the store". Pass the body
		# straight through -- marketplace.js turns data.error into the sentence.
		if nick_body=$(hub_http_post "/api/v1/me" "$nick_body_tmp"); then
			printf '{ "result": 0, "data": %s }\n' "$nick_body"
		else
			echo '{ "result": 1, "error": "hub_unreachable" }'
		fi
		rm -f "$nick_body_tmp"
		;;

	"hub_export_key")
		# device.key IS the account password: whoever holds it can publish as
		# this creator and delete their work. That is why this sits behind the
		# write ACL rather than read.
		ensure_device_identity

		# Handing the key out once is enough to stop nagging -- it has been
		# rendered into a browser by now, downloaded or copied. The flag only
		# collapses the reminder; it is not a claim that the user actually
		# stored it safely, and nothing depends on it being true.
		uci -q set aurora.theme.hub_key_saved='1'
		uci -q commit aurora

		json_init
		json_add_int "result" 0
		json_add_string "key" "$DEVICE_TOKEN"
		json_dump; json_cleanup
		;;

	"hub_import_key")
		read -r input; json_load "$input" 2>/dev/null
		json_get_var key "key"
		json_cleanup

		# Same rule as the hub's TOKEN_PATTERN. Length first, then a
		# character-class sweep, so nothing but 64 hex ever reaches the
		# credential file.
		[ "${#key}" -eq 64 ] || {
			echo '{ "result": 1, "error": "invalid_key" }'; exit 0; }
		case "$key" in *[!a-f0-9]*)
			echo '{ "result": 1, "error": "invalid_key" }'; exit 0 ;;
		esac

		mkdir -p "$DEVICE_DIR"
		# write-tmp-then-mv: a concurrent hub_share must never read a
		# half-written key and authenticate as nobody.
		printf '%s' "$key" > "$DEVICE_DIR/device.key.tmp"
		chmod 600 "$DEVICE_DIR/device.key.tmp"
		mv "$DEVICE_DIR/device.key.tmp" "$DEVICE_DIR/device.key"

		# An imported key is by definition stored somewhere else already, so
		# the backup reminder has nothing left to ask for.
		uci -q set aurora.theme.hub_key_saved='1'
		uci -q commit aurora

		echo '{ "result": 0 }'
		;;

	"hub_update")
		read -r input; json_load "$input" 2>/dev/null
		json_get_var id "id"
		json_get_var name "name"
		json_get_var description "description"
		json_cleanup

		case "$id" in ''|*[!A-Za-z0-9]*)
			echo '{ "result": 1, "error": "invalid_id" }'; exit 0 ;;
		esac

		has_control_char "$name" && {
			echo '{ "result": 1, "error": "invalid_name" }'; exit 0; }
		name_len=${#name}
		[ "$name_len" -ge 1 ] && [ "$name_len" -le 60 ] || {
			echo '{ "result": 1, "error": "invalid_name" }'; exit 0; }

		has_control_char "$description" && {
			echo '{ "result": 1, "error": "invalid_description" }'; exit 0; }
		[ "${#description}" -le 500 ] || {
			echo '{ "result": 1, "error": "invalid_description" }'; exit 0; }

		require_color_token_keys || {
			echo '{ "result": 1, "error": "config_unavailable" }'; exit 0; }

		ensure_device_identity

		update_payload_tmp=$(mktemp)
		if ! build_share_payload "$update_payload_tmp"; then
			rm -f "$update_payload_tmp" "$update_payload_tmp.b64"
			echo '{ "result": 1, "error": "payload_build_failed" }'
			exit 0
		fi
		update_payload_json=$(cat "$update_payload_tmp")
		update_assets_json="[$(tr '\n' ',' < "$update_payload_tmp.b64" 2>/dev/null | sed 's/,$//')]"
		rm -f "$update_payload_tmp" "$update_payload_tmp.b64"

		name_esc=$(json_escape_string "$name")
		description_esc=$(json_escape_string "$description")

		# Same as hub_share: signing follows the profile, not the request.
		update_body_tmp=$(mktemp)
		printf '{"device_token":"%s","name":"%s","description":"%s","payload":%s,"assets":%s}' \
			"$DEVICE_TOKEN" "$name_esc" "$description_esc" \
			"$update_payload_json" "$update_assets_json" \
			> "$update_body_tmp"

		update_body=$(hub_http_put "/api/v1/themes/aurora/configs/$id" "$update_body_tmp")
		update_rc=$?
		rm -f "$update_body_tmp"

		case "$update_rc" in
			0)
				json_load "$update_body" 2>/dev/null
				json_get_var update_version "version"
				json_cleanup
				update_version=$(printf '%s' "$update_version" | tr -d '[:cntrl:]')
				json_init
				json_add_int "result" 0
				json_add_string "version" "$update_version"
				json_dump; json_cleanup
			;;
			2) echo '{ "result": 1, "error": "invalid_id" }' ;;
			*) echo '{ "result": 1, "error": "hub_unreachable" }' ;;
		esac
		;;

	"hub_delete")
		read -r input; json_load "$input" 2>/dev/null
		json_get_var id "id"
		json_cleanup

		case "$id" in ''|*[!A-Za-z0-9]*)
			echo '{ "result": 1, "error": "invalid_id" }'; exit 0 ;;
		esac

		ensure_device_identity

		delete_body_tmp=$(mktemp)
		printf '{"device_token":"%s"}' "$DEVICE_TOKEN" > "$delete_body_tmp"

		hub_http_delete "/api/v1/themes/aurora/configs/$id" "$delete_body_tmp" >/dev/null
		delete_rc=$?
		rm -f "$delete_body_tmp"

		case "$delete_rc" in
			# No local bookkeeping to undo -- hub_me re-reads the truth.
			0) echo '{ "result": 0 }' ;;
			# The hub has no such share anymore. Reporting that as
			# hub_unreachable sent the user off checking their internet over a
			# share that was simply already gone.
			2) echo '{ "result": 1, "error": "invalid_id" }' ;;
			*) echo '{ "result": 1, "error": "hub_unreachable" }' ;;
		esac
		;;

	esac
	;;
esac
